{
  "request": {
    "method": "POST",
    "path": "/v1/bridge/start",
    "body": {
      "direction": "sideways",
      "amount": "10000000",
      "monadAddress": "0x000000000000000000000000000000000000dEaD"
    },
    "auth": true
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "bad_direction",
        "message": "direction is monad_to_stellar or stellar_to_monad.",
        "detail": null
      }
    }
  },
  "anonymous": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Sign in on Stellar to continue.",
        "detail": null
      }
    }
  }
}
