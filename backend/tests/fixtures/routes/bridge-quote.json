{
  "request": {
    "method": "POST",
    "path": "/v1/bridge/quote",
    "body": {
      "direction": "stellar_to_monad",
      "amount": "10000000"
    },
    "auth": true
  },
  "response": {
    "status": 502,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "bridge_quote_failed",
        "message": "The bridge fee isn't available right now. Try again in a minute.",
        "detail": null
      }
    }
  },
  "anonymous": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Sign in on Stellar to continue.",
        "detail": null
      }
    }
  }
}
