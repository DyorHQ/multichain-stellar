{
  "request": {
    "method": "POST",
    "path": "/v1/cash/track",
    "body": {
      "anchor": "example.com",
      "kind": "deposit",
      "asset": "USDC",
      "anchorTxId": "1"
    },
    "auth": true
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8",
