      "error": {
        "code": "bad_anchor",
        "message": "Unknown anchor.",
        "detail": null
      }
    }
  },
  "anonymous": {
    "status": 401,
    "headers": {
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store"
    },
    "body": {
      "error": {
        "code": "unauthorized",
        "message": "Sign in on Stellar to continue.",
        "detail": null
      }
    }
  }
}
