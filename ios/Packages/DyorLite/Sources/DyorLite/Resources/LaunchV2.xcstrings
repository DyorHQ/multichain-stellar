{
  "sourceLanguage" : "en",
  "strings" : {
    "%@'s graduation marked delayed" : {
      "comment" : "A notification's title: the user recorded that a coin's graduation is delayed. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graduación de %@ marcada como retrasada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graduation de %@ marquée comme retardée"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 졸업이 지연으로 표시됨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的毕业已标记为延迟"
          }
        }
      }
    },
    "Apply the change of %@'s fee recipient" : {
      "comment" : "A transaction's title: carry out a pending change of the account that receives a coin's creator fees, now that its wait is over. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicar el cambio del receptor de comisiones de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appliquer le changement de destinataire des frais de %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 수수료 수령인 변경 적용"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "执行 %@ 费用接收方的变更"
          }
        }
      }
    },
    "Change %@'s fee recipient" : {
      "comment" : "A transaction's title: the account that receives a coin's creator fees hands them to another account. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el receptor de comisiones de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer le destinataire des frais de %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 수수료 수령인 변경"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改 %@ 的费用接收方"
          }
        }
      }
    },
    "Changed %@'s fee recipient" : {
      "comment" : "A notification's title: a coin's creator fees now go to another account. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receptor de comisiones de %@ cambiado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destinataire des frais de %@ changé"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 수수료 수령인이 변경됐어요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已更改 %@ 的费用接收方"
          }
        }
      }
    },
    "Claim creator fees owed to you" : {
      "comment" : "A transaction's title: collect the creator fees a coin earned for the user before its fee recipient changed",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrar las comisiones de creador que se te deben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérer les frais de créateur qui vous sont dus"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받아야 할 크리에이터 수수료 받기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "领取欠你的创作者费用"
          }
        }
      }
    },
    "Claim your %@ holder rewards" : {
      "comment" : "A transaction's title: collect the user's share of a coin's fees, paid to its holders. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrar tus recompensas de holder de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérer vos récompenses de détenteur %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 홀더 보상 받기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "领取你的 %@ 持有者奖励"
          }
        }
      }
    },
    "Claimed %@ holder rewards" : {
      "comment" : "A notification's title: the user collected their share of a coin's fees paid to holders. The value is the coin's ticker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recompensas de holder de %@ cobradas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récompenses de détenteur %@ récupérées"
