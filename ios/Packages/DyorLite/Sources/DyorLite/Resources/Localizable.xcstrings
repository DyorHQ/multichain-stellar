    "Anyone with this key controls your Stellar account. Never share it." : {
      "comment" : "A warning under the Stellar secret key, once shown.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga esta clave controla tu cuenta de Stellar. Nunca la compartas."
