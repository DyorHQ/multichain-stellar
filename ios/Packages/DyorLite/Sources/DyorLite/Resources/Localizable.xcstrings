        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte Stellar n'est pas encore prêt. Réessayez dans un instant."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 계정이 아직 준비되지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Stellar 账户尚未就绪。请稍后重试。"
          }
        }
      }
    },
    "Your Stellar key isn't on this iPhone yet. Sign in again on this iPhone to use Stellar." : {
      "comment" : "An error: this device doesn't hold the account's Stellar key (the host usually shows its own, more exact copy).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de Stellar aún no está en este iPhone. Vuelve a iniciar sesión en este iPhone para usar Stellar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé Stellar n'est pas encore sur cet iPhone. Reconnectez-vous sur cet iPhone pour utiliser Stellar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 키가 아직 이 iPhone에 없습니다. Stellar를 사용하려면 이 iPhone에서 다시 로그인하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
