{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %lld collected" : {
      "comment" : "A Moment tile's caption: %@ is its price with its asset (“1.5 USDC”), the number how many editions were collected (an open edition, with no maximum).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · coleccionadas: %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · collectées : %lld"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %lld개 수집됨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 已收藏 %lld 份"
          }
        }
      }
    },
    "%@ · %lld/%lld collected" : {
      "comment" : "A Moment tile's caption: %@ is its price with its asset (“1.5 USDC”), then editions collected / the most there can be.",
