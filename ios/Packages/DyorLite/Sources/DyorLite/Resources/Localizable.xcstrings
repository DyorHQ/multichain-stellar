            "value" : "%@ 단계가 네트워크에서 실패했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在网络上失败。"
          }
        }
      }
    },
    "%@ graduated" : {
      "comment" : "A notification's title: a coin moved to its Soroswap pool; %@ is its ticker.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se graduó"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gradué"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 졸업 완료"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已毕业"
          }
        }
      }
    },
    "%@ was sent; confirmation not seen yet." : {
      "comment" : "An error: a step was sent to Stellar, but its confirmation hasn't been seen yet; %@ is the step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se envió; aún no se ve la confirmación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été envoyé ; confirmation pas encore reçue."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 단계를 보냈지만 아직 확인되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已发送；尚未看到确认。"
          }
        }
      }
    },
    "%@ · %lld collected" : {
