    },
    "Not signed: %@ didn't pass the checks (%@). Nothing was sent." : {
      "comment" : "An error: the phone refused to sign a step; %1$@ is the step, %2$@ the check that failed.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firmar: %1$@ no superó las comprobaciones (%2$@). No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non signé : %1$@ n'a pas passé les vérifications (%2$@). Rien n'a été envoyé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명하지 않았습니다: %1$@ 단계가 검사를 통과하지 못했습니다(%2$@). 아무것도 보내지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未签名：%1$@ 未通过检查（%2$@）。未发送任何内容。"
          }
        }
      }
    },
    "Not signed: the network fee for %@ went up since you confirmed. Nothing was sent." : {
      "comment" : "An error: a step's network fee came out higher than the one confirmed; %@ is the step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin firmar: la comisión de red de %@ subió desde que confirmaste. No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non signé : les frais de réseau de %@ ont augmenté depuis votre confirmation. Rien n'a été envoyé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명하지 않았습니다: 확인한 뒤 %@의 네트워크 수수료가 올랐습니다. 아무것도 보내지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
