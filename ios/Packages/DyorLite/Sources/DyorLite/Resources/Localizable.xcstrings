    "Anyone with this key controls your Stellar account. Never share it." : {
      "comment" : "A warning under the Stellar secret key, once shown.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga esta clave controla tu cuenta de Stellar. Nunca la compartas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne qui a cette clé contrôle votre compte Stellar. Ne la partagez jamais."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키를 가진 사람은 누구나 내 Stellar 계정을 제어할 수 있습니다. 절대 공유하지 마십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何拥有此密钥的人都能控制你的 Stellar 账户。切勿分享。"
