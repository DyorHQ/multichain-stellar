{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ to %@" : {
      "comment" : "A notification after a send on Stellar: %1$@ %2$@ is the amount and its asset, %3$@ where it went (a short address).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ a %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ à %3$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@에 %1$@ %2$@ 보냄"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 至 %3$@"
          }
        }
      }
    },
    "%@ %@ · Blend" : {
      "comment" : "A notification after an Earn deposit or withdrawal: %@ %@ is the amount and its asset. Blend is the lending protocol's name.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ · Blend"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ · Blend"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ · Blend"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ · Blend"
          }
        }
      }
    },
    "%@ failed on the network (%@)." : {
      "comment" : "An error: a step of a transaction failed on Stellar; %1$@ is the step, %2$@ the network's own code for why.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ falló en la red (%2$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a échoué sur le réseau (%2$@)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 단계가 네트워크에서 실패했습니다(%2$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 在网络上失败（%2$@）。"
          }
        }
      }
    },
    "%@ failed on the network." : {
      "comment" : "An error: a step of a transaction failed on Stellar; %@ is the step.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ falló en la red."
          }
        },
        "fr" : {
