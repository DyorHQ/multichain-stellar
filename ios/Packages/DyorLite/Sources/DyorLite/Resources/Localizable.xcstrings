          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous reconnecterez pour utiliser Stellar. Vos fonds Stellar restent sur votre compte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar를 사용하려면 다시 로그인해야 해요. Stellar 자금은 계정에 그대로 있어요."
