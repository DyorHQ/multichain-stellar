+
+    private func confirmLine(_ symbol: String, _ text: LocalizedStringResource) -> some View {
+        Label {
+            Paragraph(text)
+        } icon: {
+            Image(systemName: symbol).font(.body).frame(width: symbolColumn)
+        }
+        .modifier(ParagraphLabel())
+        .font(.subheadline)
+        .foregroundStyle(.secondary)
