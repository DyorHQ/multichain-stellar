@@ -0,0 +1,36 @@
+// The app's full-screen covers, hoisted out of MainTabView (docs/DESIGN-network-switch.md §8.1). Internal builds only.
+#if STELLAR_LITE
+import SwiftUI
+
+/// What opens over the app as a full-screen cover: the side menu, and Portfolio, News, Get Help, Profile and the
+/// notification center, as build 23's `MainTabView` presents them. Out of it, so the root can present them above the swap
+/// between the networks' trees: a switch made from Profile happens under Profile, which then closes onto the new Home
+/// (§2.5). `MainTabView(hostsCovers: false)` leaves them to the root; `isHosting` false applies nothing.
+struct AppCovers: ViewModifier {
+    let isHosting: Bool
+    @Environment(Router.self) private var router
+
+    init(isHosting: Bool = true) {
+        self.isHosting = isHosting
+    }
+
+    func body(content: Content) -> some View {
+        @Bindable var router = router
+        if isHosting {
+            content
+                .fullScreenCover(isPresented: $router.menuOpen) { SideMenuView() }
+                .fullScreenCover(item: $router.presented) { screen in
+                    switch screen {
+                    case .portfolio: PortfolioView()
+                    case .news: NewsView()
+                    case .help: GetHelpView()
+                    case .profile: ProfileView(presented: true)
+                    case .notifications: NotificationCenterView()
+                    }
+                }
+        } else {
+            content
+        }
+    }
+}
+#endif
diff --git a/ios/DyorHQ/Lite/AppNetwork.swift b/ios/DyorHQ/Lite/AppNetwork.swift
new file mode 100644
index 0000000..b1127e3
--- /dev/null
+++ b/ios/DyorHQ/Lite/AppNetwork.swift
@@ -0,0 +1,180 @@
+// The network the app shows, Monad or Stellar (docs/DESIGN-network-switch.md). Internal builds only (STELLAR_LITE).
+#if STELLAR_LITE
+import DyorKit
+import DyorLite
+import Foundation
+
+/// The network on screen: Monad, build 23's screens, or Stellar, DyorLite's. The user picks it with the network chip on
+/// Home or in Profile; it is remembered per account (`stored(for:)`), and a new account starts on Monad. Never called a
+/// mode on screen: the words are the networks' names.
+enum AppNetwork: String, CaseIterable, Identifiable, Hashable {
+    /// Listed first: the sheet's rows and the push between the two Homes keep this order (Monad leading, Stellar trailing).
+    case monad, stellar
+
+    var id: String { rawValue }
+
+    /// The network's name. Never translated: drawn with `Text(verbatim:)`, and a `%@` that names it isn't translated
+    /// either.
+    var name: String {
+        switch self {
+        case .monad: return "Monad" // not localized: a network's name
+        case .stellar: return "Stellar" // not localized: a network's name
+        }
+    }
+
+    /// The bundled image of the network's mark (`NetworkMark`): `logo-MON.png` from TokenLogos, and `logo-XLM.png`,
+    /// Stellar's official mark, which only the internal app ships (Internal/Resources, added by Internal/generate.py;
+    /// ruling 3).
+    var markImage: String {
+        switch self {
+        case .monad: return "logo-MON"
+        case .stellar: return "logo-XLM"
+        }
+    }
+
+    /// A test network, whose balances have no value: Stellar, whose contracts this build pins to Stellar's testnet
+    /// (`LiteGate.isTestnet`). It decides the Testnet badge and every testnet line, so a mainnet build needs no change to
+    /// them (open question 7).
+    var isTestnet: Bool {
+        switch self {
+        case .monad: return false
+        case .stellar: return LiteGate.isTestnet
+        }
+    }
+
+    /// The chain, as Profile's Network section names it: "Monad mainnet", "Stellar testnet".
+    var chainLabel: String {
+        switch self {
+        case .monad: return tr("Monad mainnet")
+        case .stellar: return isTestnet ? liteTr(LocalizedStringResource("Stellar testnet", table: "Lite", comment: "Profile › Network, the Chain row, when Stellar is the network: Stellar's test network. Stellar is a network's name, never translated")) : name
+        }
+    }
+
+    /// What DyorHQ does on the network, under its name in the network sheet.
+    var summary: String {
+        switch self {
+        case .monad: return liteTr(LocalizedStringResource("Spot, perps, launches and Moments", table: "Lite", comment: "The network sheet: what DyorHQ does on Monad, under its name. “Moments” is a feature name. At most 2 lines"))
+        case .stellar: return liteTr(LocalizedStringResource("Earn, swap, launch and collect", table: "Lite", comment: "The network sheet: what you can do on Stellar in DyorHQ, under its name. At most 2 lines"))
+        }
+    }
+}
+
+/// Stellar's tabs: Home, Earn, Launch, Moments (§3.3), as the router keeps the selection (`Router.stellarTab`) and the
+/// side menu's Stellar rows open them; DyorLite's tab bar takes them as `LiteTab`.
+enum StellarTab: String, CaseIterable, Identifiable, Hashable {
+    case home, earn, launch, moments
+    var id: String { rawValue }
+
+    init(_ tab: LiteTab) {
+        switch tab {
+        case .home: self = .home
+        case .earn: self = .earn
+        case .launch: self = .launch
+        case .moments: self = .moments
+        }
+    }
+
+    /// DyorLite's tab for it; setting one selects the matching tab (the tab bar's selection, `NetworkRoot`).
+    var liteTab: LiteTab {
+        get {
+            switch self {
+            case .home: return .home
+            case .earn: return .earn
+            case .launch: return .launch
+            case .moments: return .moments
+            }
+        }
+        set { self = StellarTab(newValue) }
+    }
+}
+
+/// Whether the account signed in can switch to Stellar on this iPhone, and if not, why (§2.1). Only asked where the network
+/// control exists (`LiteGate.availability`): there, an account that can't use Stellar still sees the control, and the
+/// sheet's Stellar row says why instead of being missing.
+enum NetworkAvailability: Hashable {
+    case offered
+    case unavailable(Reason)
+
+    enum Reason: Hashable {
+        /// A sign-in method whose wallet has no Stellar key yet: Apple, Google, an email code, a Privy passkey.
+        case signInMethod(Session.Method)
+        /// A watched address: nothing can be signed.
+        case watchOnly
+        /// An email & password account whose Stellar key isn't on this iPhone: it signed in before Stellar support.
+        case signInAgain
+        /// An imported wallet whose Stellar key isn't on this iPhone: it was imported before Stellar support.
+        case importAgain
+
+        /// The reason, in the app's language, as the sheet's Stellar row says it.
+        var message: String {
+            switch self {
+            case .signInMethod(let method):
+                return liteTr(LocalizedStringResource("Not available for \(method.nameInSentence) sign-in yet.", table: "Lite", comment: "The network sheet's Stellar row, when this account can't use Stellar: %@ is the sign-in method as written in a sentence (Apple, Google, email, passkey (Privy))"))
+            case .watchOnly:
+                return liteTr(LocalizedStringResource("Not available while watching an address.", table: "Lite", comment: "The network sheet's Stellar row, for a watched address: Stellar can't be used without signing in"))
+            case .signInAgain:
+                return liteTr(LocalizedStringResource("Sign in again with your email and password to use Stellar on this iPhone.", table: "Lite", comment: "The network sheet's Stellar row, for an email & password account whose Stellar key isn't on this iPhone yet: signing in again creates it"))
+            case .importAgain:
+                return liteTr(LocalizedStringResource("Import this wallet again on this iPhone to use Stellar.", table: "Lite", comment: "The network sheet's Stellar row, for an imported wallet whose Stellar key isn't on this iPhone yet: importing it again creates it"))
+            }
+        }
+    }
+
+    /// Why Stellar can't be chosen; nil when it can.
+    var reason: Reason? {
+        if case .unavailable(let reason) = self { return reason }
+        return nil
+    }
+}
+
+// MARK: Remembered per account
+
+extension AppNetwork {
+    private static func key(_ address: Address) -> String { "network.\(address)" }
+    private static func introKey(_ address: Address) -> String { "network.stellarIntroSeen.\(address)" }
+    /// The internal build's earlier key, "pro" or "lite" (the drop-in's `AppMode`), moved to `network.<address>` once.
+    private static func legacyKey(_ address: Address) -> String { "lite.mode.\(address)" }
+
+    /// The network `address` was last on: Monad for a new account, and with nobody signed in. A value the earlier key
+    /// left is moved over the first time, and that key removed.
+    static func stored(for address: Address?, defaults: UserDefaults = .standard) -> AppNetwork {
+        guard let address else { return .monad }
+        if let raw = defaults.string(forKey: key(address)) { return AppNetwork(rawValue: raw) ?? .monad }
+        guard let mode = defaults.string(forKey: legacyKey(address)) else { return .monad }
+        let network: AppNetwork = mode == "lite" ? .stellar : .monad
+        defaults.set(network.rawValue, forKey: key(address))
+        defaults.removeObject(forKey: legacyKey(address))
+        return network
+    }
+
+    static func store(_ network: AppNetwork, for address: Address?, defaults: UserDefaults = .standard) {
+        guard let address else { return }
+        defaults.set(network.rawValue, forKey: key(address))
+        defaults.removeObject(forKey: legacyKey(address))
+    }
+
+    /// Whether this account has been through Confirm on this iPhone: the first switch to Stellar explains what changes
+    /// (§3.6.2), and later switches don't.
+    static func stellarIntroSeen(for address: Address?, defaults: UserDefaults = .standard) -> Bool {
+        guard let address else { return false }
+        return defaults.bool(forKey: introKey(address))
+    }
+
+    /// Marked when Confirm's "Switch to Stellar" is tapped: the Setup run that follows is the consent.
+    static func markStellarIntroSeen(for address: Address?, defaults: UserDefaults = .standard) {
+        guard let address else { return }
+        defaults.set(true, forKey: introKey(address))
+    }
+
+    /// Sign-out and erase (`LiteKeyBootstrap.forget`): the network and the intro remembered for `address`, and the earlier
+    /// key if it was never moved.
+    static func forget(_ address: Address, defaults: UserDefaults = .standard) {
+        for key in [key(address), introKey(address), legacyKey(address)] { defaults.removeObject(forKey: key) }
+    }
+}
+
+extension String {
+    /// A Stellar address as Profile shows it: its first and last four characters, `GBQ4…7ZKD`.
+    var stellarShort: String { count > 12 ? "\(prefix(4))…\(suffix(4))" : self }
+}
+#endif
diff --git a/ios/DyorHQ/Lite/DyorHQLiteKeys.swift b/ios/DyorHQ/Lite/DyorHQLiteKeys.swift
new file mode 100644
index 0000000..68c2fd5
--- /dev/null
+++ b/ios/DyorHQ/Lite/DyorHQLiteKeys.swift
@@ -0,0 +1,143 @@
+// The account's Stellar key, from the secret it already has (docs/ARCHITECTURE.md §3.2), and its unlock for the network
+// switch's setup run (docs/DESIGN-network-switch.md §8.1).
+#if STELLAR_LITE
+import DyorKit
+import DyorLite
+import Foundation
+import StellarKit
+
+enum DyorHQLiteKeys {
+    /// The Stellar address of `evm`'s account on this iPhone (public), stored once its key was derived here; nil before.
+    /// An email & password or imported account has it only with its seed in the Keychain (`LiteKeyBootstrap.save`), so
+    /// for them it also says the Stellar key is on this iPhone (`LiteGate.availability`).
+    static func stellarAddress(for evm: Address) -> String? { UserDefaults.standard.string(forKey: "lite.stellar.\(evm)") }
+    private static func store(_ stellar: String, for evm: Address) { UserDefaults.standard.set(stellar, forKey: "lite.stellar.\(evm)") }
+
+    /// The network the Keychain files the seeds and sessions under: the build's pinned one.
+    static var network: String { LiteGate.pinned.network.name }
+
+    /// The provider for the signed-in account, made without a prompt; nil while its Stellar address isn't known (a passkey
+    /// account before its first unlock). It signs every transaction after the setup run, with one prompt each.
+    @MainActor
+    static func provider(session: Session) -> LiteKeyProvider? {
+        guard let account = session.account, let stellar = stellarAddress(for: account.address) else { return nil }
+        return make(session: session, method: account.method, evm: account.address, stellar: stellar)
+    }
+
+    /// The setup run's one prompt (`LiteSession`'s `unlock`), for `evm`'s account only: the passkey once for a passkey
+    /// account, whose Stellar address it derives and stores; Face ID or the passcode through `BiometricGate`, then the
+    /// Keychain's seed, for an email & password or imported account. Returns the provider for later signatures and this
+    /// run's signer. `reason` comes translated.
+    @MainActor
+    static func unlock(session: Session, evm: Address, reason: String) async throws -> LiteSession.UnlockResult {
+        guard let account = session.account, account.address == evm else { throw LiteSession.Failure.keyNotOnDevice }
+        switch account.method {
+        case .meraPasskey:
+            let signer = try StellarDerivation.sep5(mnemonic: try await passkeyPhrase(session.mera, evm: evm))
+            store(signer.address, for: evm)
+            return LiteSession.UnlockResult(keys: passkeyProvider(session.mera, evm: evm, stellar: signer.address), signer: signer)
+        case .emailPassword, .imported:
+            // Derived and stored at sign-in or import (`LiteKeyBootstrap`): an account from before Stellar support has none.
+            guard let stellar = stellarAddress(for: evm), StellarKeychain.seed(account: stellar, network: network) != nil else {
+                throw LiteSession.Failure.keyNotOnDevice
+            }
+            let keys = GatedSeedKeyProvider(address: stellar, methodLabel: account.method.title, network: network)
+            return LiteSession.UnlockResult(keys: keys, signer: try await keys.signer(reason: reason))
+        case .apple, .google, .email, .passkey, .watchOnly:
+            throw LiteSession.Failure.keyNotOnDevice
+        }
+    }
+
+    @MainActor
+    private static func make(session: Session, method: Session.Method, evm: Address, stellar: String) -> LiteKeyProvider? {
+        switch method {
+        case .meraPasskey: return passkeyProvider(session.mera, evm: evm, stellar: stellar)
+        case .emailPassword, .imported: return GatedSeedKeyProvider(address: stellar, methodLabel: method.title, network: network)
+        case .apple, .google, .email, .passkey, .watchOnly: return nil
+        }
+    }
+
+    /// A passkey account's Stellar key: a fresh passkey ceremony per signature; the words never outlive the call.
+    private static func passkeyProvider(_ mera: MeraSession, evm: Address, stellar: String) -> LiteKeyProvider {
+        PhraseKeyProvider(address: stellar, methodLabel: Session.Method.meraPasskey.title) { _ in
+            try await passkeyPhrase(mera, evm: evm)
+        }
+    }
+
+    /// The passkey account's recovery phrase, from one ceremony pinned to `evm`'s passkey. A cancelled ceremony and another
+    /// account's passkey are said as the setup run says them.
+    @MainActor
+    private static func passkeyPhrase(_ mera: MeraSession, evm: Address) async throws -> String {
+        do {
+            return try await mera.revealPhrase(expecting: evm).joined(separator: " ")
+        } catch PasskeyCeremony.Failure.cancelled {
+            throw LiteSession.Failure.cancelled
+        } catch PasskeyCeremony.Failure.wrongCredential, MeraSession.Failure.differentPasskey {
+            throw LiteSession.Failure.otherAccountsKey
+        }
+    }
+}
+
+/// The Stellar seed of an email & password or imported account, kept in this iPhone's Keychain (`StellarKeychain`). Every
+/// signature asks for Face ID or the passcode through `BiometricGate`, so the privacy cover stays off behind the prompt
+/// (RootView), then reads the seed. DyorLite's `StoredSeedKeyProvider` asks LocalAuthentication itself, which the cover
+/// doesn't know about.
+struct GatedSeedKeyProvider: LiteKeyProvider {
+    let address: String
+    let methodLabel: String
+    let network: String
+    let canSign = true
+    let canExportSecret = true
+
+    func signer(reason: String) async throws -> StellarSigner {
+        guard await BiometricGate.authenticate(reason: reason) else { throw LiteSession.Failure.cancelled }
+        guard let seed = StellarKeychain.seed(account: address, network: network) else { throw LiteSession.Failure.keyNotOnDevice }
+        let signer = try StellarSigner(seed: seed)
+        guard signer.address == address else { throw KeyError.badSeed }
+        return signer
+    }
+}
+
+/// Hooks for the two sign-in paths that hold their secret only briefly (docs/INTEGRATION-ios.md §4): the email v2 log-in
+/// and bind (`Session.logInWithPassword` / `bindEmailPassword`, where seed and pepper are in hand) and the import flow
+/// (`ImportWalletView.runImport`, which still has the phrase or key) call these while they still have the secret.
+enum LiteKeyBootstrap {
+    static func didDeriveEmailWallet(seed: Data, pepper: Data, evm: Address) {
+        guard let signer = try? StellarDerivation.emailV2(seed: [UInt8](seed), pepper: [UInt8](pepper)) else { return }
+        save(signer, evm: evm)
+    }
+
+    static func didImport(privateKey: Data, evm: Address) {
+        guard let signer = try? StellarDerivation.fromSecp256k1(privateKey: [UInt8](privateKey)) else { return }
+        save(signer, evm: evm)
+    }
+
+    static func didImport(phrase: String, evm: Address) {
+        // The words exactly as DyorKit's WalletImport reads them (lowercased, any whitespace), so the Stellar key comes
+        // from the same BIP-39 seed as the imported Monad key.
+        let words = phrase.lowercased().split(whereSeparator: { $0 == " " || $0 == "\n" || $0 == "\t" || $0 == "\r" })
+        guard let signer = try? StellarDerivation.sep5(mnemonic: words.joined(separator: " ")) else { return }
+        save(signer, evm: evm)
+    }
+
+    /// Sign-out and erase: the Stellar seed and session stored for `evm`, DyorLite's "this account is set up" cache
+    /// (`lite.activated.<G…>`, `LiteSession.activatedKey`), the remembered address, and the network and Stellar intro
+    /// remembered for the account (`AppNetwork.forget`). Call before UserDefaults is wiped (it holds the Stellar address
+    /// the Keychain items are filed under).
+    static func forget(evm: Address) {
+        if let stellar = UserDefaults.standard.string(forKey: "lite.stellar.\(evm)") {
+            StellarKeychain.erase(account: stellar)
+            UserDefaults.standard.removeObject(forKey: "lite.activated.\(stellar)")
+        }
+        UserDefaults.standard.removeObject(forKey: "lite.stellar.\(evm)")
+        AppNetwork.forget(evm)
+    }
+
+    private static func save(_ signer: StellarSigner, evm: Address) {
+        guard let seed = try? StrKey.decode(.seed, signer.secret) else { return }
+        // Remember the address only once the seed is in the Keychain: an address without its seed can't sign.
+        guard (try? StellarKeychain.saveSeed(seed, account: signer.address, network: DyorHQLiteKeys.network)) != nil else { return }
+        UserDefaults.standard.set(signer.address, forKey: "lite.stellar.\(evm)")
+    }
+}
+#endif
diff --git a/ios/DyorHQ/Lite/LiteMode.swift b/ios/DyorHQ/Lite/LiteMode.swift
new file mode 100644
index 0000000..430fe6d
--- /dev/null
+++ b/ios/DyorHQ/Lite/LiteMode.swift
@@ -0,0 +1,67 @@
+// Drop-in for the DyorHQ app target (after the Oct 13 submission; see docs/INTEGRATION-ios.md).
+// Compiled only into builds with the STELLAR_LITE flag (internal TestFlight group).
+#if STELLAR_LITE
+import DyorKit
+import DyorLite
+import StellarKit
+import SwiftUI
+
+/// Whether the network control exists, and what it offers the account signed in (docs/DESIGN-network-switch.md §2.1). It
+/// exists in this build (STELLAR_LITE) with a Lite API URL and the owner's `stellarLite` switch explicitly true
+/// (`StellarRemoteFlag`: off unless the row says so). The Lite API's own tester allowlist is the third gate, met by
+/// Setup's invite step.
+enum LiteGate {
+    /// What the network control offers the account signed in; nil where the control doesn't exist (no API URL, the
+    /// owner's switch off, nobody signed in), and the screens are build 23's. An account that can't use Stellar still sees
+    /// the control, and the sheet says why (open question 3).
+    @MainActor
+    static func availability(session: Session) -> NetworkAvailability? {
+        guard StellarRemoteFlag.shared.isOn || debugForceOn, apiURL != nil, let account = session.account else { return nil }
+        switch account.method {
+        case .meraPasskey:
+            // The first switch derives the Stellar key from the passkey, with one prompt.
+            return .offered
+        case .emailPassword:
+            // Derived at sign-in (`LiteKeyBootstrap`): an account signed in before Stellar support signs in again.
+            return DyorHQLiteKeys.stellarAddress(for: account.address) == nil ? .unavailable(.signInAgain) : .offered
+        case .imported:
+            // Derived at import, from the phrase or key still in hand: a wallet imported before then is imported again.
+            return DyorHQLiteKeys.stellarAddress(for: account.address) == nil ? .unavailable(.importAgain) : .offered
+        case .watchOnly:
+            return .unavailable(.watchOnly)
+        case .apple, .google, .email, .passkey:
+            // Privy holds these wallets' keys: no Stellar key for them yet (Privy Stellar wallets come later).
+            return .unavailable(.signInMethod(account.method))
+        }
+    }
+
+    /// Debug builds only: `LiteDebugForceOn` (YES in the internal project's Debug configuration) stands in for the
+    /// `stellarLite` remote flag, so the simulator can use Stellar without changing the server's flags. Release ignores it.
+    static var debugForceOn: Bool {
+        #if DEBUG
+        return (Bundle.main.object(forInfoDictionaryKey: "LiteDebugForceOn") as? String) == "YES"
+        #else
+        return false
+        #endif
+    }
+
+    /// LITE_API_URL from Info.plist; nil (and no network control) in a build that doesn't set it.
+    static var apiURL: URL? {
+        guard let text = Bundle.main.object(forInfoDictionaryKey: "LITE_API_URL") as? String, !text.isEmpty else { return nil }
+        return URL(string: text)
+    }
+
+    /// The contracts this build signs calls to: Stellar's testnet deployment. The server's sponsor must match, or Setup
+    /// stops at its first check ("Update DyorHQ to use Stellar"), so the server's network is this one.
+    static let pinned: PinnedContracts = .testnet
+
+    /// Whether that network is a test network, whose balances have no value (`AppNetwork.isTestnet`).
+    static var isTestnet: Bool { pinned.network != .mainnet }
+
+    /// Only read once the control exists, which needs `apiURL`.
+    static var environment: LiteEnvironment {
+        let build = Int(Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "0") ?? 0
+        return LiteEnvironment(apiURL: apiURL!, pinned: pinned, buildNumber: build)
+    }
+}
+#endif
diff --git a/ios/DyorHQ/Lite/LiteText.swift b/ios/DyorHQ/Lite/LiteText.swift
new file mode 100644
index 0000000..9c8f67f
--- /dev/null
+++ b/ios/DyorHQ/Lite/LiteText.swift
@@ -0,0 +1,36 @@
+// The network switch's own text: table "Lite". Internal builds only (STELLAR_LITE).
+//
+// The table is ios/Internal/Resources/Lite.xcstrings, which Internal/generate.py adds to the internal target only: the
+// App Store app never ships it, and its Localizable.xcstrings stays build 23's. Text the app already has (Close, Back, Try
+// again, Network, Chain, Monad mainnet, No connection…, Confirm with %@, Signed in, Receive, Send) keeps coming from
+// Localizable, through the app's own `tr()` and `Text("…")`.
+//
+// Every Lite literal names the table where it is written, so the build extracts it into this table:
+// `LocalizedStringResource("…", table: "Lite", comment: "…")`, resolved with `liteTr(_:)` (or by `Paragraph` and
+// `InlineError`, which take the resource as it is), and `Text("…", tableName: "Lite", comment: "…")` in SwiftUI.
+//
+// Keeping the table up to date, from the internal build only (the App Store build has none of this text):
+// 1. Sync: build DyorHQInternal.xcodeproj (SWIFT_EMIT_LOC_STRINGS is on), then
+//    `xcrun xcstringstool sync ios/Internal/Resources/Lite.xcstrings --stringsdata <file>…` with every .stringsdata under
+//    the internal build's DyorHQ.build/Objects-normal (DerivedData/Build/Intermediates.noindex/DyorHQInternal.build/…).
+//    Never scripts/dev/strings-sync.sh: it syncs Localizable and DyorKit's catalog, not this table.
+// 2. Translate: give every key es, fr, zh-Hans and ko (and its English), with the comment written at its call site; a key
+//    with a [tight] comment stays short. scripts/dev/check-strings.py reads every tracked ios/**/*.xcstrings, this table
+//    included once it is committed: run it with --enforce.
+#if STELLAR_LITE
+import DyorKit
+import Foundation
+
+enum LiteText {
+    /// The table every Lite string is in.
+    static let table = "Lite"
+}
+
+/// Lite's text for a place that takes a `String`, in the language in use: `resource` resolved exactly as the app's `tr()`
+/// resolves its own, with `L10n.locale` set on it, so an in-app language change reaches it at once. Its table must be
+/// "Lite" (written at the call site, where the build reads it).
+func liteTr(_ resource: LocalizedStringResource) -> String {
+    assert(resource.table == LiteText.table, "Lite text is looked up in table \(LiteText.table): \(resource.key)")
+    return tr(resource)
+}
+#endif
diff --git a/ios/DyorHQ/Lite/MonadBridgeAdapter.swift b/ios/DyorHQ/Lite/MonadBridgeAdapter.swift
new file mode 100644
index 0000000..3ba01b2
--- /dev/null
+++ b/ios/DyorHQ/Lite/MonadBridgeAdapter.swift
@@ -0,0 +1,44 @@
+// The Pro wallet signs the Monad side of the bridge (testnet CCTP: chain 10143), through DyorKit's own sender.
+#if STELLAR_LITE
+import BigInt
+import DyorKit
+import DyorLite
+import Foundation
+import StellarKit
+
+struct MonadBridgeAdapter: LiteMonadBridge {
+    let session: Session
+    static let testnetChainId = 10143
+    static let testnetRPC = URL(string: "https://testnet-rpc.monad.xyz")!
+
+    var monadAddress: String { MainActor.assumeIsolated { session.address?.description ?? "" } }
+
+    func send(_ steps: [EvmStep]) async throws -> String {
+        guard steps.allSatisfy({ $0.chainId == Self.testnetChainId }) else { throw LiteAPIError.decoding("a Monad step for another chain") }
+        guard let wallet = await MainActor.run(body: { session.wallet(for: nil) }) else { throw LiteAPIError.notSignedIn }
+        let sender = TransactionSender(rpc: RPCClient(url: Self.testnetRPC), chainId: Self.testnetChainId)
+        let plan: [TransactionStep] = try steps.map { s in
+            guard let to = Address(s.to), let data = Data(hexString: s.data) else { throw LiteAPIError.decoding("a Monad step") }
+            return TransactionStep.call(TransactionRequest(to: to, data: data, value: BigUInt(s.value) ?? 0), label: s.label)
+        }
+        let hash = try await sender.run(plan, from: wallet) { _ in }
+        return "0x" + hash.map { String(format: "%02x", $0) }.joined()
+    }
+}
+
+private extension Data {
+    init?(hexString: String) {
+        let s = hexString.hasPrefix("0x") ? String(hexString.dropFirst(2)) : hexString
+        guard s.count % 2 == 0 else { return nil }
+        var out = Data(capacity: s.count / 2)
+        var i = s.startIndex
+        while i < s.endIndex {
+            let j = s.index(i, offsetBy: 2)
+            guard let b = UInt8(s[i..<j], radix: 16) else { return nil }
+            out.append(b)
+            i = j
+        }
+        self = out
+    }
+}
+#endif
diff --git a/ios/DyorHQ/Lite/NetworkChip.swift b/ios/DyorHQ/Lite/NetworkChip.swift
new file mode 100644
index 0000000..67c9467
--- /dev/null
+++ b/ios/DyorHQ/Lite/NetworkChip.swift
@@ -0,0 +1,250 @@
+// The network switch's shared pieces (docs/DESIGN-network-switch.md §3.1). Internal builds only (STELLAR_LITE).
+#if STELLAR_LITE
+import DyorKit
+import SwiftUI
+
+/// A network's mark: its bundled image in the look of every logo's disc. Monad's is `logo-MON`, a purple disc; Stellar's is
+/// `logo-XLM`, its official white mark on a black disc, which only the internal app ships (Internal/Resources, ruling 3)
+/// and which the ring edges in dark mode. Drawn from the network itself, never looked up by a symbol: a coin's logo is
+/// decided by its address (`TokenLogo`), and a symbol-keyed one is Perps' and Bridge's alone (`MarketLogo`). Decorative:
+/// the network's name is always beside it, or in the label of what holds it.
+struct NetworkMark: View {
+    let network: AppNetwork
+    /// 18 in the chip, 36 in the sheet's rows, 40 in the route.
+    var size: CGFloat = 36
+
+    var body: some View {
+        Group {
+            if let image = UIImage(named: network.markImage) {
+                Image(uiImage: image).resizable().scaledToFit()
+            } else {
+                // Not bundled: the network's initial, as a coin with no logo shows letters.
+                Text(verbatim: String(network.name.prefix(1)))
+                    .font(.system(size: size * 0.42, weight: .bold, design: .rounded))
+                    .foregroundStyle(.secondary)
+            }
+        }
+        // `LogoDisc`'s look (Components.swift): a neutral plate, clipped round, under the faint ring that suits the
+        // appearance; Smart Invert leaves the mark as it is.
+        .frame(width: size, height: size)
+        .background(Color(.tertiarySystemFill))
+        .clipShape(Circle())
+        .accessibilityIgnoresInvertColors()
+        .overlay(Circle().strokeBorder(Color.logoRing, lineWidth: 0.5))
+        .accessibilityHidden(true)
+    }
+}
+
+/// "Testnet", after Stellar's name wherever the network is named: the chip, the sheet's row, Profile's Network row. The
+/// look of `UnverifiedBadge`: the attention colour on a 14% capsule of it.
+struct TestnetBadge: View {
+    var body: some View {
+        Text("Testnet", tableName: "Lite", comment: "[tight] A badge after the name Stellar: Stellar's test network, where balances have no value. One short word if possible")
+            .font(.caption2.weight(.semibold))
+            // One line at its own width, never wrapped or hyphenated ("Test-/net"): where it doesn't fit, the chip moves
+            // it below the name instead.
+            .lineLimit(1)
+            .fixedSize()
+            .foregroundStyle(Color.attention)
+            .padding(.horizontal, 6).padding(.vertical, 1)
+            .background(Color.attention.opacity(0.14), in: Capsule())
+            .accessibilityLabel(Text(verbatim: Self.spoken))
+    }
+
+    /// What VoiceOver says for the badge, and after a test network's name wherever the badge follows it.
+    static var spoken: String {
+        liteTr(LocalizedStringResource("Test network", table: "Lite", comment: "VoiceOver: the spoken form of the Testnet badge after the name Stellar"))
+    }
+}
+
+/// The network control, "◉ Monad ⌄": the first row of Home's balance card on both networks' Homes, and inside Profile's
+/// Network row. A filled capsule, so it reads as a control, matching the Total Volume period chip beside it. A tap opens
+/// the network sheet from Home (`Router.networkSheet`); `interactive: false` draws the same look without a button, for the
+/// Profile row, which is the button there.
+struct NetworkChip: View {
+    let network: AppNetwork
+    let interactive: Bool
+    @Environment(Router.self) private var router
+    /// The mark grows with the name's text.
+    @ScaledMetric(relativeTo: .subheadline) private var markSize: CGFloat = 18
+    @AccessibilityFocusState private var focused: Bool
+
+    init(network: AppNetwork, interactive: Bool = true) {
+        self.network = network
+        self.interactive = interactive
+    }
+
+    var body: some View {
+        if interactive {
+            Button {
+                Haptics.tap()
+                router.networkSheet = NetworkSheetRequest(origin: .home)
+            } label: {
+                chip
+                    // A 44 pt target around the 32 pt capsule: the row holding it is 44 pt tall (`NetworkChipRow`).
+                    .frame(minHeight: 44)
+                    .contentShape(Rectangle())
+            }
+            .buttonStyle(NetworkChipPressStyle())
+            .networkControlAccessibility(network)
+            .accessibilityFocused($focused)
+            // Right after a swap, VoiceOver starts on the new Home's chip (§6): this chip appears with the request set.
+            .task(id: router.focusesNetworkChip) {
+                guard router.focusesNetworkChip else { return }
+                router.focusesNetworkChip = false
+                try? await Task.sleep(for: .milliseconds(350)) // the push settles
+                guard !Task.isCancelled else { return }
+                AccessibilityNotification.ScreenChanged().post()
+                focused = true
+            }
+        } else {
+            chip
+        }
+    }
+
+    /// The capsule, with Stellar's Testnet badge inside it; at the accessibility sizes, where that doesn't fit, the badge
+    /// goes on its own line just below.
+    private var chip: some View {
+        ViewThatFits(in: .horizontal) {
+            capsule(badge: true)
+            VStack(alignment: .leading, spacing: 4) {
+                capsule(badge: false)
+                if network.isTestnet { TestnetBadge() }
+            }
+        }
+    }
+
+    private func capsule(badge: Bool) -> some View {
+        HStack(spacing: 6) {
+            NetworkMark(network: network, size: markSize)
+            Text(verbatim: network.name).font(.subheadline.weight(.medium))
+            if badge, network.isTestnet { TestnetBadge() }
+            Image(systemName: "chevron.down").font(.caption2.weight(.semibold))
+        }
+        .foregroundStyle(.primary)
+        // The disc sits optically inside the capsule: 6 before it, 10 after the chevron, 6 above and below (32 pt tall).
+        .padding(.leading, 6).padding(.trailing, 10).padding(.vertical, 6)
+        .background(Color(.tertiarySystemFill), in: Capsule())
+    }
+}
+
+extension View {
+    /// What VoiceOver says for the network control, the chip on Home and Profile's Network row alike: "Network: Stellar",
+    /// "Test network" after it on a test network, a button that changes the network.
+    func networkControlAccessibility(_ network: AppNetwork) -> some View {
+        accessibilityElement(children: .ignore)
+            .accessibilityLabel(Text("Network: \(network.name)", tableName: "Lite", comment: "VoiceOver: the network control on Home and in Profile. %@ is a network's name (Monad, Stellar), not translated"))
+            .accessibilityValue(Text(verbatim: network.isTestnet ? TestnetBadge.spoken : ""))
+            .accessibilityHint(Text("Changes the network.", tableName: "Lite", comment: "VoiceOver hint: what the network control on Home and in Profile does"))
+            .accessibilityAddTraits(.isButton)
+    }
+}
+
+/// The chip pressed: a little smaller and lighter (140 ms); lighter only with Reduce Motion.
+private struct NetworkChipPressStyle: ButtonStyle {
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .scaleEffect(configuration.isPressed && !reduceMotion ? 0.97 : 1)
+            .opacity(configuration.isPressed ? 0.85 : 1)
+            .animation(.easeOut(duration: 0.14), value: configuration.isPressed)
+    }
+}
+
+/// The chip as the first row of a Home's balance card (§3.2): a 44 pt row that gives back 6 pt below it, so the capsule
+/// sits 16 pt from the card's top edge (with the card's top padding of 10) and 14 pt above the balance.
+struct NetworkChipRow: View {
+    let network: AppNetwork
+
+    var body: some View {
+        // The whole row is the chip's to fit in, not the half an HStack beside a Spacer offers it, which wrapped
+        // Stellar's badge.
+        NetworkChip(network: network)
+            .frame(maxWidth: .infinity, minHeight: 44, alignment: .leading)
+            .padding(.bottom, -6)
+    }
+}
+
+/// From one network to the other, "◉ → ✦", at the top of the sheet's Confirm and Setup steps. `done` puts a check on the
+/// destination once the switch is ready.
+struct NetworkRoute: View {
+    let from: AppNetwork
+    let to: AppNetwork
+    let done: Bool
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+
+    init(from: AppNetwork, to: AppNetwork, done: Bool = false) {
+        self.from = from
+        self.to = to
+        self.done = done
+    }
+
+    var body: some View {
+        HStack(spacing: 16) {
+            NetworkMark(network: from, size: 40)
+            Image(systemName: "arrow.right")
+                .font(.title3.weight(.semibold))
+                .foregroundStyle(.secondary)
+            NetworkMark(network: to, size: 40)
+                .overlay(alignment: .bottomTrailing) {
+                    if done {
+                        Image(systemName: "checkmark.circle.fill")
+                            .font(.system(size: 18))
+                            .foregroundStyle(Color.positive)
+                            // A 2 pt ring of the sheet's ground, so the check reads on any mark.
+                            .background(Circle().fill(Color(.systemBackground)).padding(-2))
+                            .offset(x: 4, y: 4)
+                            .transition(reduceMotion ? .opacity : .scale(scale: 0.6).combined(with: .opacity))
+                    }
+                }
+                .animation(reduceMotion ? .easeOut(duration: 0.22) : .spring(duration: 0.22), value: done)
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(Text("From \(from.name) to \(to.name)", tableName: "Lite", comment: "VoiceOver: the two network marks at the top of the network sheet. Two network names (Monad, Stellar), not translated"))
+        .accessibilityAddTraits(.isImage)
+    }
+}
+
+/// The header of a picker-style sheet: a bold title on the left, an optional back button before it, and a round close
+/// button on the right, each a 32 pt circle in a 44 pt target. The metrics of Perps' `sheetHeader` (PerpTradeView.swift),
+/// which stays as it is: this is the network sheet's own copy, so the App Store build is untouched (ruling 1).
+struct SheetHeader: View {
+    private let title: Text?
+    private let onBack: (() -> Void)?
+    private let onClose: (() -> Void)?
+
+    /// `title` nil: no title (Confirm and Setup). `onBack` nil: no back button. `onClose` nil: no close button.
+    init(title: Text? = nil, onBack: (() -> Void)? = nil, onClose: (() -> Void)?) {
+        self.title = title
+        self.onBack = onBack
+        self.onClose = onClose
+    }
+
+    var body: some View {
+        HStack {
+            if let onBack {
+                circleButton("chevron.left", label: Text("Back"), action: onBack)
+            }
+            if let title {
+                title.font(.title2.weight(.bold))
+            }
+            Spacer()
+            if let onClose {
+                circleButton("xmark", label: Text("Close", comment: "Closes this screen or sheet (a verb)"), action: onClose)
+            }
+        }
+        .padding(.top, 20).padding(.horizontal, 20).padding(.bottom, 8)
+    }
+
+    private func circleButton(_ symbol: String, label: Text, action: @escaping () -> Void) -> some View {
+        Button(action: action) {
+            Image(systemName: symbol).font(.subheadline.weight(.semibold)).foregroundStyle(.secondary)
+                .frame(width: 32, height: 32).background(Color(.tertiarySystemFill), in: Circle())
+                .frame(width: 44, height: 44).contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(label)
+    }
+}
+#endif
