+
+    /// "Switch to Stellar" on Confirm: the intro is seen, and the Setup run that follows is the consent (no third tap).
+    private func confirm() {
+        markIntroSeen()
+        go(to: .setup)
+    }
+
+    private func hand(_ network: AppNetwork) {
+        finished = true
+        choose(network)
+    }
