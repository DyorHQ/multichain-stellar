// Copy to Secrets.xcconfig (git-ignored) and fill in. Every value ships inside the app bundle, so only public
// identifiers belong here. See DyorHQ/internal: ios-app/docs/env-setup.md for where each comes from.

// Privy dashboard → App ID, and Clients → the mobile client created for bundle id fun.dyorhq.app / scheme dyorhq.
PRIVY_APP_ID =
PRIVY_CLIENT_ID =

// Optional dedicated Monad mainnet RPC; the public https://rpc.monad.xyz is used when empty.
MONAD_RPC_URL =

// Passkeys (Mera). The rpId is not set here: it is the constant Mera.relyingParty (accounts.dyorhq.fun) in DyorKit,
// and project.yml carries the matching entitlement webcredentials:accounts.dyorhq.fun. Device builds need a paid Apple
// Developer team with Associated Domains on the App ID, and Apple's CDN serving the AASA
// (https://app-site-association.cdn-apple.com/a/v1/accounts.dyorhq.fun) before the first install.
// YES offers passkey accounts next to the other sign-in methods; empty hides them.
PASSKEYS_ENABLED =

// YES shows Apple + Google sign-in (both must be enabled in Privy → Login methods → Socials with DyorHQ's own
// credentials, and dyorhq in the mobile client's allowed URL schemes). Empty hides both.
SOCIAL_LOGINS_ENABLED =

// Perpl builder code (1–255), 0 for none.
PERPL_BUILDER_ID = 0

// Launchpad and Moments contracts, DEBUG BUILDS ONLY (a Release build never reads them). Leave unset: the app uses the
// audited v2 deployments baked into DyorKit (LaunchpadAddresses.monadMainnet / MomentsAddresses.monadMainnet, kept
// equal to contracts/deployments/143.json and moments-143.json by DyorKit's tests and
// scripts/dev/check-launchpad-addresses.py). To point a simulator build at a v2 deployment on an anvil fork, set
// MONAD_RPC_URL to the fork and all five LAUNCHPAD_* / all ten MOMENTS_* values from the fork's pending-*.json records
// (MOMENTS_DEPLOY_BLOCK is the factory's creation block; deploy the fork's Moments with the c4 link base,
// dyorhq.fun/moments/c4/, or Publish stays off). Never set them in the Xcode Cloud workflow.
LAUNCHPAD_FACTORY =
LAUNCH_ROUTER =
FEE_ESCROW =
HOLDER_FEE_SHARING =
MEME_HOOK =
MOMENTS_FACTORY =
MOMENTS_COLLECT =
MOMENTS_VESTING =
MOMENTS_GRADUATION =
MOMENTS_LOCKER =
MOMENTS_HOOK =
MOMENTS_BUYBACK =
MOMENTS_PLATFORM =
MOMENTS_TREASURY =
MOMENTS_DEPLOY_BLOCK =

// Apple Developer Team ID for automatic signing: Xcode → Settings → Accounts → your team → Team ID. Device builds need
// a paid Apple Developer Program team: the app carries the Sign in with Apple entitlement, which a Personal Team can't
// sign (Simulator builds need no team). Not the suffix in the certificate name — that is a certificate id.
DEVELOPMENT_TEAM =
