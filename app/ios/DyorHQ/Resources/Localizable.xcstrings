    },
    "The bridge quote didn't match the amount you entered, so nothing was sent. Get a new quote." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cotización del puente no coincidía con la cantidad que introdujiste, así que no se envió nada. Obtén una nueva cotización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cotation du bridge ne correspondait pas au montant saisi : rien n'a donc été envoyé. Obtenez une nouvelle cotation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브리지 견적이 입력한 금액과 일치하지 않아 아무것도 전송되지 않았습니다. 새 견적을 받으십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
