    "Nothing was deleted: removing the email sign-in DyorHQ created at Privy didn't work (%@). Try again in a few minutes, or contact %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing was deleted: removing the email sign-in DyorHQ created at Privy didn't work (%1$@). Try again in a few minutes, or contact %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se eliminó nada: no se pudo quitar el inicio de sesión con correo electrónico que DyorHQ creó en Privy (%1$@). Vuelve a intentarlo en unos minutos o contacta con %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été supprimé : la suppression de la connexion par e-mail créée par DyorHQ chez Privy a échoué (%1$@). Réessayez dans quelques minutes ou contactez %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 삭제되지 않았습니다. DyorHQ가 Privy에 만든 이메일 로그인을 제거하지 못했습니다(%1$@). 몇 분 후 다시 시도하거나 %2$@에 문의하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未删除任何内容：移除 DyorHQ 在 Privy 创建的邮箱登录方式失败（%1$@）。几分钟后重试，或联系 %2$@。"
          }
        }
      }
    },
    "Nothing was sent. Close this and try again." : {
