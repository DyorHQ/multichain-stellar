    "Your balances couldn't be read just now — showing the last ones read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer tus saldos en este momento; se muestran los últimos leídos."
          }
        },
        "fr" : {
          "stringUnit" : {
