    "Send MON or USDC on Monad to your account. Funds usually arrive in seconds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía MON o USDC en Monad a tu cuenta. Los fondos suelen llegar en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des MON ou des USDC sur Monad vers votre compte. Les fonds arrivent généralement en quelques secondes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monad의 MON 또는 USDC를 계정으로 보내세요. 자금은 보통 몇 초 안에 도착해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Monad 上向你的账户发送 MON 或 USDC。资金通常几秒内到账。"
          }
        }
      }
