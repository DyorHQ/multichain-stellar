    "Position opened, but Perpl didn't accept the stop-loss. Set it with TP/SL on the position." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posición abierta, pero Perpl no aceptó el stop loss. Configúralo con TP/SL en la posición."
          }
