          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 익절 주문은 취소되었지만 Perpl이 새 주문을 거부했습니다(%@). 현재 이 포지션에는 익절 주문이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
