          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez exporté et confirmé la phrase de récupération."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 구문을 내보내고 확인했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已导出并确认助记词。"
          }
        }
      }
    },
    "You get" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous obtenez"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받는 것"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你将获得"
          }
        }
      }
    },
    "You have %lld take-profit/stop-loss orders live on Perpl. Removing the key doesn't cancel them: they stay armed, and this device can't show or cancel them until you connect again." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You have %lld take-profit/stop-loss order live on Perpl. Removing the key doesn't cancel it: it stays armed, and this device can't show or cancel it until you connect again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You have %lld take-profit/stop-loss orders live on Perpl. Removing the key doesn't cancel them: they stay armed, and this device can't show or cancel them until you connect again."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tienes %lld orden de take profit/stop loss activa en Perpl. Quitar la clave no la cancela: sigue activa, y este dispositivo no puede mostrarla ni cancelarla hasta que te conectes de nuevo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Tienes %lld órdenes de take profit/stop loss activas en Perpl. Quitar la clave no las cancela: siguen activas, y este dispositivo no puede mostrarlas ni cancelarlas hasta que te conectes de nuevo."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vous avez %lld ordre take profit/stop loss actif sur Perpl. Supprimer la clé ne l'annule pas : il reste actif, et cet appareil ne peut ni l'afficher ni l'annuler tant que vous ne vous reconnectez pas."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Vous avez %lld ordres take profit/stop loss actifs sur Perpl. Supprimer la clé ne les annule pas : ils restent actifs, et cet appareil ne peut ni les afficher ni les annuler tant que vous ne vous reconnectez pas."
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Perpl에 활성 상태인 익절/손절 주문이 %lld건 있습니다. 키를 제거해도 주문은 취소되지 않습니다. 주문은 활성 상태로 유지되며, 다시 연결하기 전까지 이 기기에서는 주문을 보거나 취소할 수 없습니다."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "你在 Perpl 上有 %lld 个仍有效的止盈/止损订单。移除密钥不会取消订单：订单仍保持有效，在你重新连接之前，此设备无法显示或取消订单。"
                }
              }
            }
          }
        }
      }
    },
    "You pay" : {
