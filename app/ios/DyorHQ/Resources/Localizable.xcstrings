    "Transactions" : {
      "comment" : "A notification center filter [tight]",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transacciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transactions"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易"
          }
        }
      }
    },
    "Transactions, tokens and Moments you created stay on the Monad blockchain — nothing can remove them — and images you published for coins or Moments stay online because those tokens point to them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transacciones, los tokens y los Moments que creaste permanecen en la blockchain de Monad (nada puede eliminarlos), y las imágenes que publicaste para monedas o Moments siguen en línea porque esos tokens apuntan a ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transactions, jetons et Moments que vous avez créés restent sur la blockchain Monad — rien ne peut les supprimer — et les images que vous avez publiées pour des jetons ou des Moments restent en ligne, car ces jetons y renvoient."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 만든 트랜잭션, 토큰, Moment는 Monad 블록체인에 남으며 무엇으로도 제거할 수 없습니다. 코인이나 Moment용으로 게시한 이미지도 해당 토큰이 가리키고 있으므로 온라인에 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你创建的交易、代币和 Moment 会保留在 Monad 区块链上，任何方式都无法移除；你为币或 Moment 发布的图片也会保持在线，因为这些代币指向它们。"
          }
        }
      }
    },
