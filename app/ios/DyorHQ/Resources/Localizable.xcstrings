    "This position has %lld TP/SL on Perpl. Once it is fully closed, the app cancels them while Perpl trading is connected, so they can't fire on your next long here. Check Orders afterwards." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This position has %lld TP/SL on Perpl. Once it is fully closed, the app cancels it while Perpl trading is connected, so it can't fire on your next long here. Check Orders afterwards."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This position has %lld TP/SL on Perpl. Once it is fully closed, the app cancels them while Perpl trading is connected, so they can't fire on your next long here. Check Orders afterwards."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Esta posición tiene %lld TP/SL en Perpl. Cuando se cierre por completo, la app lo cancela mientras el trading en Perpl esté conectado, para que no pueda activarse en tu próxima posición larga aquí. Revisa Órdenes después."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Esta posición tiene %lld TP/SL en Perpl. Cuando se cierre por completo, la app los cancela mientras el trading en Perpl esté conectado, para que no puedan activarse en tu próxima posición larga aquí. Revisa Órdenes después."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cette position a %lld TP/SL sur Perpl. Une fois la position entièrement clôturée, l'app l'annule tant que le trading Perpl est connecté, afin qu'il ne puisse pas se déclencher sur votre prochain long ici. Vérifiez ensuite l'onglet Ordres."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cette position a %lld TP/SL sur Perpl. Une fois la position entièrement clôturée, l'app les annule tant que le trading Perpl est connecté, afin qu'ils ne puissent pas se déclencher sur votre prochain long ici. Vérifiez ensuite l'onglet Ordres."
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "이 포지션에는 Perpl에 익절/손절 주문이 %lld건 있습니다. 포지션이 완전히 종료되면 Perpl 거래가 연결되어 있는 동안 앱이 이를 취소하므로, 이 마켓의 다음 롱 포지션에서 실행될 수 없습니다. 이후 ‘주문’ 탭을 확인하십시오."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "此仓位在 Perpl 上有 %lld 个止盈/止损。完全平仓后，只要 Perpl 交易保持连接，应用就会将其取消，使其不会在你在此的下一个做多仓位上触发。之后查看“委托”。"
                }
              }
            }
          }
        }
      }
    },
