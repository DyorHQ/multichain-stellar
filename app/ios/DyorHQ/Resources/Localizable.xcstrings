        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative de graduation a échoué. N'importe qui peut la relancer ; vous ne payez que les frais de gaz."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 졸업 시도가 실패했어요. 누구나 다시 시도할 수 있으며, 가스비만 부담하면 돼요."
          }
