    "We’ll email a one-time code to %@. Entering it proves the email is yours, then we log you in." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviaremos un código de verificación a %@. Al introducirlo demuestras que el correo electrónico es tuyo, y luego iniciamos tu sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous enverrons un code à usage unique par e-mail à %@. Le saisir prouve que l'e-mail vous appartient, puis nous vous connectons."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 주소로 일회용 인증 코드를 보내 드려요. 코드를 입력하면 이메일이 본인 소유임이 증명되고, 바로 로그인돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会向 %@ 发送一次性验证码。输入验证码即可证明该邮箱属于你，随后我们会为你登录。"
          }
        }
