          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 DyorHQ Moments 컨트랙트예요. 수집은 종료되었어요. 베스팅된 코인을 수령하고, 크리에이터라면 내 수익금을 출금하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
