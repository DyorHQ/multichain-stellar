            "value" : "수령량"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你收到"
          }
        }
      }
    },
    "You receive it with your share of the trading fees; with fee sharing on, holders receive both instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo recibes junto con tu parte de las comisiones de trading; con el reparto de comisiones activado, los holders reciben ambos en tu lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous la recevez avec votre part des frais de trading ; avec le partage des frais activé, ce sont les détenteurs qui reçoivent les deux."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크리에이터 세금은 거래 수수료 중 내 몫과 함께 내가 받아요. 수수료 분배를 켜면 대신 홀더가 둘 다 받아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会连同你的交易手续费份额一起收到它；开启手续费分成时，则由持有者收到这两部分。"
          }
        }
      }
    },
    "You receive on %@" : {
