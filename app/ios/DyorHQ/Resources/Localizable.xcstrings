    "Handle is lowercase letters, numbers and underscores, 3–20 characters." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre de usuario usa letras minúsculas, números y guiones bajos, de 3 a 20 caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pseudo comporte des lettres minuscules, des chiffres et des tirets bas, de 3 à 20 caractères."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 이름은 영문 소문자, 숫자, 밑줄로 된 3~20자여야 해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名由小写字母、数字和下划线组成，长度为 3–20 个字符。"
          }
        }
      }
    },
    "Headlines come straight from each publisher's feed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los titulares vienen directamente de la fuente de cada medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres proviennent directement du flux de chaque éditeur."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "헤드라인은 각 매체의 피드에서 그대로 가져와요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "头条直接来自各发布方的信息源。"
          }
        }
      }
    },
    "Held by %@ on Monad. This version can't send, trade or sign anything." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Están en %@, en Monad. Esta versión no puede enviar, operar ni firmar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détenus par %@ sur Monad. Cette version ne peut rien envoyer, échanger ni signer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monad의 %@ 주소에 보관되어 있습니다. 이 버전에서는 아무것도 보내거나 거래하거나 서명할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由 Monad 上的 %@ 持有。此版本无法发送、交易或签署任何内容。"
          }
        }
      }
    },
