          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的钱包"
          }
        }
      }
    },
    "Your wallet is yours — you hold the keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu billetera es tuya: tú tienes las claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre portefeuille vous appartient — vous détenez les clés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 지갑은 내 것 — 키는 내가 보관해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的钱包归你所有：密钥由你掌握。"
          }
        }
      }
    },
    "Your wallet needs a Perpl account before it can trade. Opens app.perpl.xyz." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu billetera necesita una cuenta de Perpl para poder operar. Abre app.perpl.xyz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre portefeuille a besoin d'un compte Perpl avant de pouvoir trader. Ouvre app.perpl.xyz."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래하려면 지갑에 Perpl 계정이 필요해요. app.perpl.xyz가 열려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的钱包需要先有 Perpl 账户才能交易。将打开 app.perpl.xyz。"
          }
        }
      }
    },
    "Your wallet no longer holds the %@ you picked. Choose a token." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu billetera ya no tiene el %@ que elegiste. Elige un token."
