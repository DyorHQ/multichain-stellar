    "This removes the imported key from this iPhone. You'll need its recovery phrase or private key to use this wallet again — export it first (Manage Wallets → Export Wallet) if you haven't saved it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto quita la clave importada de este iPhone. Necesitarás su frase de recuperación o su clave privada para volver a usar esta billetera. Si no la has guardado, expórtala primero (Gestionar billeteras → Exportar billetera)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprime la clé importée de cet iPhone. Vous aurez besoin de sa phrase de récupération ou de sa clé privée pour utiliser à nouveau ce portefeuille — exportez-le d'abord (Gérer les portefeuilles → Exporter le portefeuille) si vous ne l'avez pas sauvegardé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 가져온 키가 제거됩니다. 이 지갑을 다시 사용하려면 복구 구문이나 개인 키가 필요합니다 — 저장해 두지 않았다면 먼저 내보내십시오(지갑 관리 → 지갑 내보내기)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会从此 iPhone 移除导入的密钥。你需要它的助记词或私钥才能再次使用此钱包。如果你还没保存，先导出（“管理钱包”→“导出钱包”）。"
          }
        }
      }
    },
    "This source token can't be bridged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este token de origen no se puede pasar por el puente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce jeton source ne peut pas passer par le bridge."
          }
        },
        "ko" : {
