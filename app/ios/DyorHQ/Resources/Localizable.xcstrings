    "How far the price may move before your swap settles. Beyond this, it cancels instead of filling worse." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuánto puede moverse el precio antes de que se complete tu intercambio. Si se supera, se cancela en lugar de ejecutarse a un precio peor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'écart de prix maximal avant le règlement de votre échange. Au-delà, l'échange est annulé au lieu d'être exécuté à un prix moins favorable."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스왑이 완료되기 전까지 허용하는 가격 변동 폭이에요. 이 범위를 넘으면 더 나쁜 가격에 체결되는 대신 취소돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的兑换结算前价格允许变动的幅度。超出此幅度时，兑换会取消，而不会以更差的价格成交。"
          }
        }
      }
    },
    "I already have a passkey" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tengo una llave de acceso"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J'ai déjà une clé d'accès"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 패스키가 있어요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已有通行密钥"
          }
        }
      }
    },
    "I understand %@ keeps its %@ and this email will no longer open it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I understand %1$@ keeps its %2$@ and this email will no longer open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que %1$@ conserva sus %2$@ y que este correo electrónico ya no la abrirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que %1$@ conserve %2$@ et que cet e-mail ne permettra plus de l'ouvrir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 지갑에 보유 자산(%2$@)이 그대로 남으며, 이 이메일로는 더 이상 이 지갑을 열 수 없다는 것을 이해합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我了解 %1$@ 会保留其 %2$@，且此邮箱将无法再打开它。"
          }
        }
      }
    },
    "I understand %@ keeps its %@, and anything else it holds, and this email will no longer open it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I understand %1$@ keeps its %2$@, and anything else it holds, and this email will no longer open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entiendo que %1$@ conserva sus %2$@ y todo lo demás que tenga, y que este correo electrónico ya no la abrirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je comprends que %1$@ conserve %2$@, ainsi que tout ce qu'il détient d'autre, et que cet e-mail ne permettra plus de l'ouvrir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 지갑에 %2$@ 및 기타 보유 자산이 그대로 남으며, 이 이메일로는 더 이상 이 지갑을 열 수 없다는 것을 이해합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我了解 %1$@ 会保留其 %2$@ 以及它持有的其他任何资产，且此邮箱将无法再打开它。"
          }
        }
      }
    },
    "I understand I may permanently lose these funds" : {
