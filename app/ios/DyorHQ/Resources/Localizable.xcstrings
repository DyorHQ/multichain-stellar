    "Take-profit accepted at %@. It activates when the order fills." : {
      "comment" : "A Perps order sheet's line: Perpl took the order's take-profit; it waits for the order to fill before it protects anything. The value: the trigger price.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take profit aceptado a %@. Se activa cuando se ejecute la orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take profit accepté à %@. Il s'active une fois l'ordre exécuté."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "익절 주문이 %@에 접수되었어요. 주문이 체결되면 활성화돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止盈已接受，价格 %@。订单成交后生效。"
          }
        }
      }
    },
    "Take-profit and stop-loss left from an earlier %@ long can't be checked while Perpl trading is offline. If you had any, check Orders first: they would act on this position." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los take profit y stop loss que hayan quedado de una posición larga anterior en %@ no se pueden comprobar mientras el trading en Perpl está desconectado. Si tenías alguno, revisa Órdenes primero: actuarían sobre esta posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les take profit et stop loss restant d'un précédent long %@ ne peuvent pas être vérifiés tant que le trading Perpl est hors ligne. Si vous en aviez, vérifiez d'abord l'onglet Ordres : ils agiraient sur cette position."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 거래가 오프라인인 동안에는 이전 %@ 롱 포지션에서 남은 익절·손절 주문을 확인할 수 없습니다. 그런 주문이 있었다면 먼저 ‘주문’ 탭을 확인하십시오. 남은 주문은 이 포지션에 작동하게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 交易离线期间，无法检查此前 %@ 做多仓位残留的止盈和止损。如果你有残留订单，先查看“委托”：它们会作用于此仓位。"
          }
        }
      }
    },
    "Take-profit and stop-loss left from an earlier %@ short can't be checked while Perpl trading is offline. If you had any, check Orders first: they would act on this position." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los take profit y stop loss que hayan quedado de una posición corta anterior en %@ no se pueden comprobar mientras el trading en Perpl está desconectado. Si tenías alguno, revisa Órdenes primero: actuarían sobre esta posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les take profit et stop loss restant d'un précédent short %@ ne peuvent pas être vérifiés tant que le trading Perpl est hors ligne. Si vous en aviez, vérifiez d'abord l'onglet Ordres : ils agiraient sur cette position."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 거래가 오프라인인 동안에는 이전 %@ 숏 포지션에서 남은 익절·손절 주문을 확인할 수 없습니다. 그런 주문이 있었다면 먼저 ‘주문’ 탭을 확인하십시오. 남은 주문은 이 포지션에 작동하게 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 交易离线期间，无法检查此前 %@ 做空仓位残留的止盈和止损。如果你有残留订单，先查看“委托”：它们会作用于此仓位。"
          }
        }
      }
    },
    "Take-profit cancelled." : {
      "comment" : "A Perps order sheet's line: the order's take-profit was cancelled some time after it was placed (from Orders, or by Perpl after the stop-loss fired).",
      "localizations" : {
