          }
        }
      }
    },
    "A session lasts %@ from the %@ that opens it, and ends when you leave the app. Change the length in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A session lasts %1$@ from the %2$@ that opens it, and ends when you leave the app. Change the length in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sesión dura %1$@ a partir de la verificación con %2$@ que la abre, y termina cuando sales de la app. Cambia la duración en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session dure %1$@ à partir de la confirmation avec %2$@ qui l'ouvre, et se termine quand vous quittez l'app. Modifiez la durée dans Réglages."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션은 %2$@로 연 시점부터 %1$@ 동안 유지되고, 앱을 떠나면 종료돼요. 길이는 설정에서 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话从开启它的那次 %2$@ 验证起持续 %1$@，并在你离开应用时结束。可在设置中更改时长。"
          }
        }
      }
    },
    "A square image works best." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una imagen cuadrada funciona mejor."
          }
        },
        "fr" : {
          "stringUnit" : {
