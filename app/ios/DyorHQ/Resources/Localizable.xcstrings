    "TP/SL" : {
      "comment" : "Take profit and stop loss, abbreviated: a switch, a button and a row label on Perps [tight]",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TP/SL"
          }
        },
        "fr" : {
          "stringUnit" : {
