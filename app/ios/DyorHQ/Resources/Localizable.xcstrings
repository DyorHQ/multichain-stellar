    },
    "Your wallet stays with your account. Sign in again to use it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu billetera se queda con tu cuenta. Vuelve a iniciar sesión para usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre portefeuille reste associé à votre compte. Reconnectez-vous pour l'utiliser."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지갑은 계정에 그대로 남아 있어요. 사용하려면 다시 로그인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的钱包会保留在你的账户中。重新登录即可使用。"
          }
        }
      }
    },
    "Your wallet's key or recovery phrase works in any other wallet app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave o la frase de recuperación de tu billetera funciona en cualquier otra app de billetera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé ou la phrase de récupération de votre portefeuille fonctionne dans n'importe quelle autre app de portefeuille."
