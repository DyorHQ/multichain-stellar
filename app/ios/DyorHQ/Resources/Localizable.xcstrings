          }
        }
      }
    },
    "The old stop-loss was cancelled, but Perpl refused the new one (%@). This position has no stop-loss now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El stop loss anterior se canceló, pero Perpl rechazó el nuevo (%@). Esta posición ahora no tiene stop loss."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ancien stop loss a été annulé, mais Perpl a refusé le nouveau (%@). Cette position n'a plus de stop loss."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 손절 주문은 취소되었지만 Perpl이 새 주문을 거부했습니다(%@). 현재 이 포지션에는 손절 주문이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧的止损已取消，但 Perpl 拒绝了新的止损（%@）。该仓位现在没有止损。"
          }
        }
      }
    },
    "The old take-profit was cancelled, but Perpl refused the new one (%@). This position has no take-profit now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El take profit anterior se canceló, pero Perpl rechazó el nuevo (%@). Esta posición ahora no tiene take profit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
