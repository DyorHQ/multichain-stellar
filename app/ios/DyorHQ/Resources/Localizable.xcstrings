    "Set a device passcode in iOS Settings to reveal your key — it protects the key if your phone is lost." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un código del dispositivo en los Ajustes de iOS para mostrar tu clave: la protege si pierdes el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un code sur l'appareil dans les Réglages d'iOS pour afficher votre clé — il protège la clé si vous perdez votre téléphone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 표시하려면 iOS 설정에서 기기 암호를 설정하십시오 — 휴대폰을 분실했을 때 키를 보호합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iOS 设置中设置设备锁屏密码后才能显示你的私钥：手机丢失时，它可以保护私钥。"
          }
        }
      }
    },
    "Set a device passcode in iOS Settings — App Lock can't confirm transactions without one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un código del dispositivo en los Ajustes de iOS: el Bloqueo de app no puede confirmar transacciones sin él."
