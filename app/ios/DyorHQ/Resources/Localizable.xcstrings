        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 토큰(%@)이 더 이상 지갑에 없습니다. 토큰을 선택하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
