    "%@ of every collect builds the reserve; at the threshold the coin graduates into a locked Uniswap pool." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de cada compra se suma a la reserva; al llegar al umbral, la moneda se gradúa en un pool de Uniswap bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de chaque achat alimente la réserve ; au seuil, le jeton gradue dans un pool Uniswap verrouillé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매 수집 금액의 %@가 준비금으로 쌓이고, 기준치에 도달하면 코인이 잠긴 Uniswap 풀로 졸업해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次收藏的 %@ 计入储备金；达到门槛后，该币将毕业并进入锁定的 Uniswap 池子。"
          }
        }
      }
    },
    "%@ of every collect, plus %@ of the pool's 1%% fee after graduation, accrue here for you." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of every collect, plus %2$@ of the pool's 1%% fee after graduation, accrue here for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de cada compra, más %2$@ de la comisión del 1%% del pool tras la graduación, se acumulan aquí para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de chaque achat, plus %2$@ des frais de 1%% du pool après la graduation, s'accumulent ici pour vous."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매 수집 금액의 %1$@와 졸업 후 풀 수수료(1%%)의 %2$@가 내 몫으로 여기에 적립돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次收藏的 %1$@，加上毕业后池子 1%% 手续费中的 %2$@，都会在此为你累积。"
          }
        }
      }
    },
    "%@ of the reserve to you, the rest to the treasury" : {
