          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bridge indique que le transfert est terminé. Vérifiez votre solde %1$@ sur %2$@ pour confirmer l'arrivée des fonds."
          }
        },
        "ko" : {
          "stringUnit" : {
