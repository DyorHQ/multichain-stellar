    "Not confirmed yet: Perpl hasn't removed the order. Check Orders: it may still be live." : {
      "comment" : "Cancel Order sheet: the cancel was sent but Perpl's list didn't confirm it in time. Orders is a tab of the Perps screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún sin confirmar: Perpl no ha retirado la orden. Revisa Órdenes: puede que siga activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore confirmé : Perpl n'a pas retiré l'ordre. Vérifiez l'onglet Ordres : il est peut-être encore actif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 확인되지 않았습니다. Perpl이 주문을 아직 제거하지 않았습니다. ‘주문’ 탭을 확인하십시오. 주문이 아직 활성 상태일 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未确认：Perpl 尚未移除该委托。查看“委托”：它可能仍然有效。"
          }
        }
      }
    },
    "Not confirmed yet: Perpl hasn't removed the stop-loss at %@ (%@). Check Orders: it may still be live." : {
      "comment" : "The TP/SL cancel sheet: the cancel was sent but Perpl's live list didn't confirm it in time, so the stop-loss may still be active. Orders is a tab of the Perps screen. The first value: its trigger price; the second: the size it closes with the asset (0.001 BTC).",
