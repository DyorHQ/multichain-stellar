    "Graduates at %@ %@ raised. Liquidity then moves to a locked %@ pool." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Graduates at %1$@ %2$@ raised. Liquidity then moves to a locked %3$@ pool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gradúa al recaudar %1$@ %2$@. Luego, la liquidez pasa a un pool bloqueado de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graduation une fois %1$@ %2$@ levés. La liquidité passe ensuite dans un pool %3$@ verrouillé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 모금 시 졸업해요. 이후 유동성은 잠긴 %3$@ 풀로 이동해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "募集 %1$@ %2$@ 后毕业。届时流动性将转入锁定的 %3$@ 池子。"
          }
        }
      }
    },
    "Graduates on" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gradúa en"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graduation sur"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "졸업 거래소"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毕业至"
          }
        }
      }
    },
    "Graduates to a locked %@ pool once the curve raises %@ %@. A %@ coin graduates on Monday Trade; if it stays stuck for a day, anyone can move it to a locked Uniswap v4 pool. Launch fee %@ MON." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Graduates to a locked %1$@ pool once the curve raises %2$@ %3$@. A %4$@ coin graduates on Monday Trade; if it stays stuck for a day, anyone can move it to a locked Uniswap v4 pool. Launch fee %5$@ MON."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gradúa a un pool bloqueado de %1$@ cuando la curva recauda %2$@ %3$@. Una moneda emparejada con %4$@ se gradúa en Monday Trade; si se queda atascada durante un día, cualquiera puede moverla a un pool bloqueado de Uniswap v4. Comisión de lanzamiento: %5$@ MON."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton gradue vers un pool %1$@ verrouillé une fois que la courbe a levé %2$@ %3$@. Un jeton %4$@ gradue sur Monday Trade ; s'il reste bloqué pendant une journée, n'importe qui peut le transférer vers un pool Uniswap v4 verrouillé. Frais de lancement : %5$@ MON."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커브 모금액이 %2$@ %3$@에 도달하면 잠긴 %1$@ 풀로 졸업해요. %4$@ 페어 코인은 Monday Trade에서 졸업하며, 하루 동안 멈춰 있으면 누구나 잠긴 Uniswap v4 풀로 옮길 수 있어요. 런칭 수수료 %5$@ MON."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲线募集到 %2$@ %3$@ 后，毕业进入锁定的 %1$@ 池子。%4$@ 币会在 Monday Trade 上毕业；如果持续卡住一天，任何人都可以将其转移到锁定的 Uniswap v4 池子。发射费 %5$@ MON。"
          }
        }
      }
    },
    "Graduates to a locked %@ pool once the curve raises %@ %@. Launch fee %@ MON." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Graduates to a locked %1$@ pool once the curve raises %2$@ %3$@. Launch fee %4$@ MON."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se gradúa a un pool bloqueado de %1$@ cuando la curva recauda %2$@ %3$@. Comisión de lanzamiento: %4$@ MON."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton gradue vers un pool %1$@ verrouillé une fois que la courbe a levé %2$@ %3$@. Frais de lancement : %4$@ MON."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커브 모금액이 %2$@ %3$@에 도달하면 잠긴 %1$@ 풀로 졸업해요. 런칭 수수료 %4$@ MON."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲线募集到 %2$@ %3$@ 后，毕业进入锁定的 %1$@ 池子。发射费 %4$@ MON。"
          }
        }
      }
    },
