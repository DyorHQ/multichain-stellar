    "Couldn't cancel the order: %@ It is still live." : {
      "comment" : "Cancel Order sheet: Perpl refused the cancel; %@ Perpl's reason, one or two whole sentences.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cancelar la orden: %@ Sigue activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'annuler l'ordre : %@ Il est toujours actif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주문을 취소하지 못했습니다: %@ 주문은 아직 활성 상태입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法取消该委托：%@ 它仍然有效。"
          }
        }
      }
    },
    "Couldn't cancel the stop-loss at %@ (%@): %@ It is still live." : {
      "comment" : "The TP/SL cancel sheet: Perpl refused to cancel a stop-loss, which stays active. The first value: its trigger price; the second: the size it closes with the asset (0.001 BTC); the third: Perpl's reason, one or two whole sentences.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't cancel the stop-loss at %1$@ (%2$@): %3$@ It is still live."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cancelar el stop loss a %1$@ (%2$@): %3$@ Sigue activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'annuler le stop loss à %1$@ (%2$@) : %3$@ Il est toujours actif."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@(%2$@) 손절 주문을 취소하지 못했습니다: %3$@ 주문은 아직 활성 상태입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法取消价格为 %1$@（%2$@）的止损：%3$@ 它仍然有效。"
          }
        }
      }
    },
    "Couldn't cancel the take-profit at %@ (%@): %@ It is still live." : {
      "comment" : "The TP/SL cancel sheet: Perpl refused to cancel a take-profit, which stays active. The first value: its trigger price; the second: the size it closes with the asset (0.001 BTC); the third: Perpl's reason, one or two whole sentences.",
