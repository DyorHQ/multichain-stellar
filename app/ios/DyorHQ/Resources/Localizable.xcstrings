    "Your DyorHQ data was deleted and this iPhone is signed out, but the sign-in account (Privy) could not be: deletion isn't enabled on the server yet. Contact support to finish." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron tus datos de DyorHQ y se cerró la sesión en este iPhone, pero la cuenta de inicio de sesión (Privy) no se pudo eliminar: la eliminación aún no está activada en el servidor. Contacta con soporte para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données DyorHQ ont été supprimées et cet iPhone est déconnecté, mais le compte de connexion (Privy) n'a pas pu l'être : la suppression n'est pas encore activée sur le serveur. Contactez l'assistance pour terminer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ 데이터가 삭제되고 이 iPhone에서 로그아웃되었지만, 로그인 계정(Privy)은 삭제하지 못했습니다. 서버에서 아직 삭제 기능이 활성화되지 않았습니다. 마무리하려면 고객 지원팀에 문의하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 DyorHQ 数据已删除，此 iPhone 也已退出登录，但登录账户（Privy）无法删除：服务器尚未启用删除功能。联系客服以完成删除。"
          }
        }
      }
    },
    "Your DyorHQ data was deleted and this iPhone is signed out, but your %@ sign-in account at Privy wasn't deleted (%@). To finish, sign in with %@ again and delete the account once more, or contact %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your DyorHQ data was deleted and this iPhone is signed out, but your %1$@ sign-in account at Privy wasn't deleted (%2$@). To finish, sign in with %3$@ again and delete the account once more, or contact %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron tus datos de DyorHQ y se cerró la sesión en este iPhone, pero tu cuenta de inicio de sesión con %1$@ en Privy no se eliminó (%2$@). Para terminar, vuelve a iniciar sesión con %3$@ y elimina la cuenta otra vez, o contacta con %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données DyorHQ ont été supprimées et cet iPhone est déconnecté, mais votre compte de connexion %1$@ chez Privy n'a pas été supprimé (%2$@). Pour terminer, reconnectez-vous avec %3$@ et supprimez à nouveau le compte, ou contactez %4$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ 데이터가 삭제되고 이 iPhone에서 로그아웃되었지만, Privy의 %1$@ 로그인 계정은 삭제되지 않았습니다(%2$@). 마무리하려면 %3$@ 계정으로 다시 로그인해 계정을 한 번 더 삭제하거나, %4$@에 문의하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 DyorHQ 数据已删除，此 iPhone 也已退出登录，但你在 Privy 的 %1$@ 登录账户未被删除（%2$@）。要完成删除，再次使用 %3$@ 登录并重新删除账户，或联系 %4$@。"
          }
        }
      }
    },
