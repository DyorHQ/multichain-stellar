          }
        }
      }
    },
    "The bridge reports it complete (%@). Check your %@ balance on %@ to confirm it arrived." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The bridge reports it complete (%1$@). Check your %2$@ balance on %3$@ to confirm it arrived."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puente lo indica como completado (%1$@). Revisa tu saldo de %2$@ en %3$@ para confirmar que llegó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bridge indique que le transfert est terminé (%1$@). Vérifiez votre solde %2$@ sur %3$@ pour confirmer l'arrivée des fonds."
          }
        },
        "ko" : {
          "stringUnit" : {
