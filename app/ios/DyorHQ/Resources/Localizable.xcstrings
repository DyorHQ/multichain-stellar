    },
    "The leverage a new perps order opens on. Each market still caps it to its own maximum." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El apalancamiento con el que se abre una nueva orden de perpetuos. Cada mercado lo sigue limitando a su propio máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le levier utilisé à l'ouverture d'un nouvel ordre perps. Chaque marché le plafonne toujours à son propre maximum."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 Perps 주문에 적용되는 레버리지예요. 각 마켓은 여전히 자체 최대치로 제한해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新永续合约订单开仓时使用的杠杆。每个市场仍会将其限制在各自的最大值以内。"
          }
        }
      }
    },
    "The limit price can have at most %lld decimal places on %@." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The limit price can have at most %1$lld decimal place on %2$@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The limit price can have at most %1$lld decimal places on %2$@."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El precio límite puede tener como máximo %1$lld decimal en %2$@."
