    "DyorHQ never holds your keys or your funds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ nunca guarda tus claves ni tus fondos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ ne détient jamais vos clés ni vos fonds."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ는 키나 자금을 절대 보관하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ 从不持有你的密钥或资金。"
          }
        }
      }
    },
    "DyorHQ notifies you once when it finds %@ above this price. Alerts arrive while DyorHQ is open: it checks every 30 seconds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ te avisa una vez cuando encuentra %@ por encima de este precio. Las alertas llegan mientras DyorHQ está abierta: revisa cada 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ vous avertit une fois lorsqu'il trouve %@ au-dessus de ce prix. Les alertes arrivent quand DyorHQ est ouvert : il vérifie toutes les 30 secondes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ가 %@ 가격이 이 가격보다 높은 것을 확인하면 한 번 알림을 보내요. 알림은 DyorHQ가 열려 있을 때 도착하며, 30초마다 확인해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ 发现 %@ 高于此价格时会通知你一次。DyorHQ 打开时会收到提醒：它每 30 秒检查一次。"
          }
        }
      }
    },
    "DyorHQ notifies you once when it finds %@ below this price. Alerts arrive while DyorHQ is open: it checks every 30 seconds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ te avisa una vez cuando encuentra %@ por debajo de este precio. Las alertas llegan mientras DyorHQ está abierta: revisa cada 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ vous avertit une fois lorsqu'il trouve %@ en dessous de ce prix. Les alertes arrivent quand DyorHQ est ouvert : il vérifie toutes les 30 secondes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ가 %@ 가격이 이 가격보다 낮은 것을 확인하면 한 번 알림을 보내요. 알림은 DyorHQ가 열려 있을 때 도착하며, 30초마다 확인해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ 发现 %@ 低于此价格时会通知你一次。DyorHQ 打开时会收到提醒：它每 30 秒检查一次。"
          }
        }
      }
    },
