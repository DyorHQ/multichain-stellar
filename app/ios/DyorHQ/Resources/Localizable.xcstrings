    "%@ If you made this password with it shown (the eye button), iOS may have typed curly quotes or a long dash in it: hold the key down to type those." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Si creaste esta contraseña mientras se mostraba (el botón del ojo), puede que iOS haya escrito comillas curvas o un guion largo: mantén presionada la tecla para escribirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Si vous avez créé ce mot de passe en l'affichant (le bouton en forme d'œil), iOS a pu y insérer des guillemets courbes ou un tiret long : maintenez la touche enfoncée pour les saisir."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 비밀번호를 표시한 상태(눈 모양 버튼)에서 만들었다면 iOS가 둥근 따옴표나 긴 대시를 입력했을 수 있습니다. 해당 키를 길게 눌러 그 문자를 입력하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@如果你是在显示密码（眼睛按钮）的状态下设置的此密码，iOS 可能在其中输入了弯引号或长破折号：长按相应按键即可输入这些字符。"
          }
        }
      }
    },
