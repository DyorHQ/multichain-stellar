        }
      }
    },
    "The news feeds could not be reached. Check your connection, then pull down or tap Try Again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo acceder a las fuentes de noticias. Revisa tu conexión y luego desliza hacia abajo o toca Volver a intentar."
          }
        },
        "fr" : {
          "stringUnit" : {
