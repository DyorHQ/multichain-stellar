    "%lld take-profit/stop-loss orders from an earlier %@ long are still armed on Perpl and would act on this new position. Cancel them from Orders first." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld take-profit/stop-loss order from an earlier %2$@ long is still armed on Perpl and would act on this new position. Cancel it from Orders first."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld take-profit/stop-loss orders from an earlier %2$@ long are still armed on Perpl and would act on this new position. Cancel them from Orders first."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld orden de take profit/stop loss de una posición larga anterior en %2$@ sigue activa en Perpl y actuaría sobre esta nueva posición. Cancélala primero desde Órdenes."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld órdenes de take profit/stop loss de una posición larga anterior en %2$@ siguen activas en Perpl y actuarían sobre esta nueva posición. Cancélalas primero desde Órdenes."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld ordre take profit/stop loss d'un précédent long %2$@ est encore actif sur Perpl et agirait sur cette nouvelle position. Annulez-le d'abord depuis l'onglet Ordres."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld ordres take profit/stop loss d'un précédent long %2$@ sont encore actifs sur Perpl et agiraient sur cette nouvelle position. Annulez-les d'abord depuis l'onglet Ordres."
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "이전 %2$@ 롱 포지션의 익절/손절 주문 %1$lld건이 Perpl에서 아직 활성 상태이며, 이 새 포지션에 작동하게 됩니다. 먼저 ‘주문’ 탭에서 취소하십시오."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "此前 %2$@ 做多仓位的 %1$lld 个止盈/止损订单在 Perpl 上仍有效，会作用于这个新仓位。先在“委托”中将其取消。"
                }
              }
            }
          }
        }
      }
    },
