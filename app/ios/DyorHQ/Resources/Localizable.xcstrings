    "Self-custodial: support can never reach your keys or funds. Never share a recovery phrase with anyone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De autocustodia: el soporte nunca puede acceder a tus claves ni a tus fondos. Nunca compartas una frase de recuperación con nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non custodial : l'assistance ne peut jamais accéder à vos clés ni à vos fonds. Ne partagez jamais une phrase de récupération avec qui que ce soit."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셀프 커스터디: 고객 지원팀은 절대 키나 자금에 접근할 수 없습니다. 복구 구문을 누구와도 절대 공유하지 마십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自托管：客服永远无法接触你的密钥或资金。切勿向任何人分享助记词。"
          }
        }
      }
    },
