    },
    "already in your account" : {
      "comment" : "[tight] My Moments tile on Stellar, under the amount of Claimed: coins already claimed into the account",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "already in your account"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ya en tu cuenta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "déjà sur votre compte"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在账户中"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정에 보유 중"
          }
        }
      }
    },
    "Claim All takes up to %lld Moments at a time; claim again for the rest." : {
      "comment" : "Under the coin tiles of My Moments on Stellar, when more Moments have coins to claim than one transaction takes. The number is how many one claim takes (20)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Claim All takes up to %lld Moments at a time; claim again for the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reclamar todo incluye hasta %lld Moments a la vez; vuelve a reclamar para el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout réclamer prend jusqu'à %lld Moments à la fois ; réclamez à nouveau pour le reste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全部领取每次最多包含 %lld 个 Moment；其余的请再次领取。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 수령은 한 번에 최대 %lld개의 Moment를 처리해요. 나머지는 다시 수령하세요."
          }
        }
      }
    },
    "Coins across every Moment you collected or published. They vest from graduation; claim what has vested here or on each Moment's page." : {
      "comment" : "Under the coin tiles of My Moments on Stellar",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Coins across every Moment you collected or published. They vest from graduation; claim what has vested here or on each Moment's page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monedas de cada Moment que coleccionaste o publicaste. Se liberan desde la graduación; reclama lo liberado aquí o en la página de cada Moment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetons de chaque Moment que vous avez collecté ou publié. Ils se débloquent à partir du diplôme ; réclamez ce qui est débloqué ici ou sur la page de chaque Moment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你收藏或发布的每个 Moment 中的币。它们从毕业起开始解锁；可在此处或各 Moment 页面领取已解锁的部分。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수집하거나 게시한 모든 Moment의 코인이에요. 졸업부터 베스팅되며, 베스팅된 코인은 여기나 각 Moment 페이지에서 수령하세요."
          }
        }
      }
    },
    "Collect a Moment and it shows up here." : {
      "comment" : "My Moments on Stellar with no Moment collected or published yet",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collect a Moment and it shows up here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colecciona un Moment y aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collectez un Moment et il apparaîtra ici."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收藏 Moment 后，它会显示在这里。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moment를 수집하면 여기에 표시돼요."
          }
        }
      }
    },
