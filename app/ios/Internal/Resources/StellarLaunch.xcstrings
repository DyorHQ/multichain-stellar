    "Wallet exempt from the early-buy tax" : {
      "comment" : "A field on Stellar's Launch a Coin screen: a wallet address that pays no early-buy (snipe) tax on the new coin, added with the Add button beside it",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallet exenta del impuesto de compra temprana"
