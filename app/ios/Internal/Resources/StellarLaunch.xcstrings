    },
    "That isn't a Stellar address." : {
      "comment" : "Under an address field on Stellar: what was typed isn't a valid G… or C… address. Stellar is a network's name, never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una dirección de Stellar."
          }
        },
