          }
        }
      }
    },
    "Graduation delayed" : {
      "comment" : "[tight] A Stellar launch's phase: its curve is full but graduating into its pool failed or took too long; retries, a fallback venue and refunds follow",
      "localizations" : {
        "es" : {
          "stringUnit" : {
