    "Not available for %@ sign-in yet." : {
      "comment" : "The network sheet's Stellar row, when this account can't use Stellar: %@ is the sign-in method as written in a sentence (Apple, Google, email, passkey (Privy))",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not available for %@ sign-in yet."
          }
        },
        "es" : {
