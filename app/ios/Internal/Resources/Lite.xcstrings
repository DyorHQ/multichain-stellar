      }
    },
    "Privy didn't confirm this Stellar wallet as yours, so DyorHQ won't use it. Nothing was signed." : {
      "comment" : "An error on the network sheet: the Stellar wallet DyorHQ's server named for an Apple, Google, email-code or Privy-passkey account isn't one Privy (the company holding the key) lists for the user",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privy no confirmó esta billetera de Stellar como tuya, así que DyorHQ no la usará. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privy n'a pas confirmé que ce portefeuille Stellar est le vôtre, donc DyorHQ ne l'utilisera pas. Rien n'a été signé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privy가 이 Stellar 지갑을 회원님의 지갑으로 확인하지 않아 DyorHQ는 이 지갑을 사용하지 않습니다. 아무것도 서명되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privy 未确认此 Stellar 钱包属于你，因此 DyorHQ 不会使用它。未签署任何内容。"
          }
        }
      }
    },
    "Same account: your Stellar key comes from the secret you already use." : {
      "comment" : "The network sheet, before the first switch to Stellar. “Secret”: the passkey, recovery phrase or password the account uses",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Same account: your Stellar key comes from the secret you already use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma cuenta: tu clave de Stellar proviene del secreto que ya usas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le même compte : votre clé Stellar provient du secret que vous utilisez déjà."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 계정이에요. Stellar 키는 이미 사용 중인 비밀 정보로 만들어져요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一个账户：你的 Stellar 密钥由你已在使用的凭证生成。"
          }
        }
      }
    },
