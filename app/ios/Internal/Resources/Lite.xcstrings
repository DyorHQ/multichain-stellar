    "DyorHQ on Stellar is invite-only while we test it." : {
      "comment" : "The network sheet's invite step: why it asks for a code",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DyorHQ on Stellar is invite-only while we test it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ en Stellar es solo por invitación mientras lo probamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ sur Stellar est accessible sur invitation uniquement pendant nos tests."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테스트하는 동안 Stellar의 DyorHQ는 초대받은 분만 사용할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试期间，Stellar 上的 DyorHQ 仅限受邀用户使用。"
          }
        }
      }
    },
    "DyorHQ on Stellar is paused for maintenance. Monad is unaffected." : {
      "comment" : "The network sheet's Setup and Stellar Home: DyorHQ's service on the Stellar network is paused; Monad works as usual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DyorHQ on Stellar is paused for maintenance. Monad is unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ en Stellar está en pausa por mantenimiento. Monad no se ve afectado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyorHQ sur Stellar est en pause pour maintenance. Monad n'est pas concerné."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar의 DyorHQ가 점검을 위해 일시 중지되었습니다. Monad는 영향을 받지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 上的 DyorHQ 正在暂停维护。Monad 不受影响。"
          }
        }
      }
    },
