{
  "sourceLanguage" : "en",
  "strings" : {
    "Access to Stellar was turned off for this account." : {
      "comment" : "The network sheet's Setup: DyorHQ turned off this account's access to its Stellar service",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Access to Stellar was turned off for this account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desactivó el acceso a Stellar para esta cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à Stellar a été désactivé pour ce compte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 Stellar 접근 권한이 해제되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户的 Stellar 访问权限已被关闭。"
