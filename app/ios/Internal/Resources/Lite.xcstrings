    "Couldn't set up your Stellar account. Nothing was spent." : {
      "comment" : "The network sheet's Setup: the account setup transaction failed, and it cost the user nothing",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't set up your Stellar account. Nothing was spent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo configurar tu cuenta de Stellar. No se gastó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
