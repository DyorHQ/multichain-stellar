    "Blend's markets couldn't be loaded. Try again." : {
      "comment" : "Stellar Earn with no market to show: Blend's lending markets couldn't be read. A Try Again button follows. Blend is a protocol's name, never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar los mercados de Blend. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les marchés de Blend. Réessayez."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blend 마켓을 불러올 수 없어요. 다시 시도해 주세요."
