          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取 Freighter"
          }
        }
      }
    },
    "Get USDC" : {
      "comment" : "Button on a Stellar Moment's collect ticket when the account's USDC is short: opens Swap to buy USDC. USDC is never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtener USDC"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenir des USDC"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC 받기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取 USDC"
          }
        }
      }
    },
    "Graduated on Soroswap. Of its pool's fees on the locked liquidity, %@ stay in the pool; of the rest, the USDC goes %@ to the creator and %@ to DyorHQ, and the coins are burned." : {
      "comment" : "Under a graduated Stellar Moment's pool. The values are shares (33.33%, 40%, 60%). Soroswap, USDC and DyorHQ are never translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Graduated on Soroswap. Of its pool's fees on the locked liquidity, %1$@ stay in the pool; of the rest, the USDC goes %2$@ to the creator and %3$@ to DyorHQ, and the coins are burned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graduada en Soroswap. De las comisiones del pool sobre la liquidez bloqueada, el %1$@ se queda en el pool; del resto, los USDC van %2$@ al creador y %3$@ a DyorHQ, y las monedas se queman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diplômé sur Soroswap. Des frais du pool sur la liquidité verrouillée, %1$@ restent dans le pool ; du reste, les USDC vont %2$@ au créateur et %3$@ à DyorHQ, et les coins sont brûlés."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soroswap에서 졸업했습니다. 잠긴 유동성에서 발생한 풀 수수료 중 %1$@는 풀에 남고, 나머지에서 USDC는 크리에이터에게 %2$@, DyorHQ에 %3$@가 가며 코인은 소각됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 Soroswap 毕业。锁定流动性产生的池手续费中，%1$@ 留在池内；其余部分中，USDC 的 %2$@ 归创作者、%3$@ 归 DyorHQ，代币则被销毁。"
          }
        }
      }
    },
    "Graduates on" : {
      "comment" : "A row of Publish a Moment on Stellar: the exchange its coin's pool opens on (Soroswap follows, never translated)",
