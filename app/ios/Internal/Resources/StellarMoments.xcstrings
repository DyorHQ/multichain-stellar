    "Contract address" : {
      "comment" : "Label in the Freighter sheet: the address of the NFT contract that holds the edition",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirección del contrato"
          }
        },
        "fr" : {
