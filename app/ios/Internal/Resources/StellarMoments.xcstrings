            "state" : "translated",
            "value" : "Adresse du contrat"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트랙트 주소"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合约地址"
          }
        }
      }
    },
    "Each edition is an NFT in your Stellar account. Freighter can show it once you add it." : {
      "comment" : "Under a Stellar Moment's position. Stellar and Freighter are never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada edición es un NFT en tu cuenta de Stellar. Freighter puede mostrarla cuando la añadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque édition est un NFT dans votre compte Stellar. Freighter peut l'afficher une fois que vous l'avez ajoutée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 에디션은 Stellar 계정에 있는 NFT입니다. 추가하면 Freighter에서 볼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个版本都是你 Stellar 账户中的一个 NFT。添加后，Freighter 即可显示它。"
          }
        }
      }
    },
    "Edition #%@" : {
      "comment" : "Under a Moment's name: which edition of it this is. The value is its number (12)",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edición n.º %@"
          }
        },
        "fr" : {
