    "Send about %@ XLM or USDC on Stellar to your account. Funds usually arrive in seconds." : {
      "comment" : "Stellar Home, the add-funds card on Stellar's main network: how to fund a new account. %@ is an amount of XLM (2). XLM, USDC and Stellar are never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía unos %@ XLM o USDC en Stellar a tu cuenta. Los fondos suelen llegar en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez environ %@ XLM ou des USDC sur Stellar vers votre compte. Les fonds arrivent généralement en quelques secondes."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar에서 약 %@ XLM 또는 USDC를 계정으로 보내세요. 자금은 보통 몇 초 안에 도착해요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Stellar 上向你的账户发送约 %@ XLM 或 USDC。资金通常几秒内到账。"
          }
        }
      }
    },
    "Send test XLM or USDC on the Stellar testnet to your account, or fund it once with Friendbot below." : {
      "comment" : "Stellar Home, the add-funds card on Stellar's test network, while the account can still claim Friendbot's free test XLM (one claim per address). Friendbot is Stellar's faucet, never translated; XLM, USDC and Stellar neither",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía XLM o USDC de prueba en la testnet de Stellar a tu cuenta, o fondéala una vez con Friendbot abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des XLM ou des USDC de test sur le testnet de Stellar vers votre compte, ou financez-le une fois avec Friendbot ci-dessous."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 테스트넷에서 테스트용 XLM 또는 USDC를 계정으로 보내거나, 아래 Friendbot으로 한 번 충전하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Stellar 测试网上向你的账户发送测试 XLM 或 USDC，或用下方的 Friendbot 充值一次。"
          }
        }
      }
    },
    "Send test XLM or USDC on the Stellar testnet to your account." : {
      "comment" : "Stellar Home, the add-funds card on Stellar's test network, once the account had Friendbot's free test XLM. XLM, USDC and Stellar are never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía XLM o USDC de prueba en la testnet de Stellar a tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des XLM ou des USDC de test sur le testnet de Stellar vers votre compte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 테스트넷에서 테스트용 XLM 또는 USDC를 계정으로 보내세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Stellar 测试网上向你的账户发送测试 XLM 或 USDC。"
          }
        }
      }
    },
    "Supply XLM or USDC on the Earn tab to start earning." : {
      "comment" : "Stellar Home, My Holdings' Earn tab when the account lends nothing: how to start. XLM and USDC are never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deposita XLM o USDC en la pestaña Rendimientos para empezar a ganar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournissez des XLM ou de l'USDC dans l'onglet Rendement pour commencer à gagner."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예치 탭에서 XLM 또는 USDC를 공급해 수익을 받기 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“理财”标签页存入 XLM 或 USDC 即可开始赚取收益。"
          }
        }
      }
    },
    "Swap %@ USDC for XLM" : {
      "comment" : "Stellar Home, the add-funds card: opens the account's first swap, DyorHQ paying its network fee. %@ is an amount of USDC (25). USDC and XLM are never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambiar %@ USDC por XLM"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échanger %@ USDC contre des XLM"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ USDC → XLM 스왑"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %@ USDC 兑换为 XLM"
          }
        }
      }
    },
    "Swap %@ for %@ at the best price across Stellar's venues." : {
      "comment" : "Stellar Home, the add-funds card once the account is funded: its first trade. The values are asset codes (XLM, then USDC), never translated; Stellar's venues are the exchanges a swap is routed through",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swap %1$@ for %2$@ at the best price across Stellar's venues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intercambia %1$@ por %2$@ al mejor precio entre las plataformas de Stellar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échangez %1$@ contre %2$@ au meilleur prix parmi les plateformes de Stellar."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar 거래소 전체에서 가장 좋은 가격으로 %1$@ → %2$@ 스왑하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Stellar 各交易场所中以最优价格将 %1$@ 兑换为 %2$@。"
          }
        }
      }
    },
    "Switch to %@" : {
      "comment" : "Stellar Home's balance card while DyorHQ on Stellar is paused: goes back to the Monad network. %@ is the network's name (Monad), never translated",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar a %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à %@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@로 전환"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到 %@"
          }
        }
      }
    },
    "Your Earn positions couldn't be read just now." : {
      "comment" : "Stellar Home, My Holdings' Earn tab before anything was read: what the account lends on Blend couldn't be read. A Retry button follows",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer tus posiciones de rendimiento en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire vos positions de rendement pour le moment."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 예치 포지션을 읽을 수 없습니다."
          }
        },
        "zh-Hans" : {
