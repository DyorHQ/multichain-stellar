    "A passkey prompt is already open. Finish or cancel it, then try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una solicitud de llave de acceso abierta. Complétala o cancélala y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de clé d'accès est déjà ouverte. Terminez-la ou annulez-la, puis réessayez."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스키 요청이 이미 열려 있습니다. 완료하거나 취소한 후 다시 시도하십시오."
