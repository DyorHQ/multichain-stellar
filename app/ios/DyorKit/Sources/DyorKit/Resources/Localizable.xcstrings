    },
    "It would have filled at once, so Perpl didn't post it as a post-only order." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names. A post-only order only rests on the order book (maker); it never fills at once.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se habría ejecutado de inmediato, así que Perpl no la publicó como orden de solo maker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il aurait été exécuté immédiatement : Perpl ne l'a donc pas placé comme ordre post-only (maker)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즉시 체결될 주문이어서 Perpl이 포스트 온리 (메이커) 주문으로 올리지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该订单会立即成交，因此 Perpl 没有将其作为只做 Maker 订单挂出。"
          }
        }
      }
    },
    "Kuru Flow could not route this trade." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuru Flow no pudo enrutar esta operación."
