        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于应用读取数据滞后，Perpl 断开了交易连接。再试一次。"
          }
        }
      }
    },
    "Perpl had no fresh price for this market. Try again in a moment." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl no tenía un precio actualizado para este mercado. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl n'avait pas de prix à jour pour ce marché. Réessayez dans un instant."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl에 이 마켓의 최신 가격이 없었습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "zh-Hans" : {
