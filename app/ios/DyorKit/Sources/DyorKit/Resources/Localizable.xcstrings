        }
      }
    },
    "That proposed policy lapsed: nobody applied it within 7 days of it becoming applicable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa política propuesta caducó: nadie la aplicó en los 7 días posteriores a que se pudiera aplicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette politique proposée a expiré : personne ne l'a appliquée dans les 7 jours après qu'elle est devenue applicable."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안된 정책이 만료되었습니다. 적용 가능해진 후 7일 이내에 아무도 적용하지 않았습니다."
