    "Stop-loss must be above %@ (%@) for a short." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stop-loss must be above %1$@ (%2$@) for a short."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El stop loss debe ser mayor que %1$@ (%2$@) en una posición corta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stop loss doit être plus élevé que %1$@ (%2$@) pour un short."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숏 포지션의 손절 가격은 %1$@(%2$@)보다 높아야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "做空时，止损必须高于%1$@（%2$@）。"
          }
        }
      }
    },
    "Stop-loss must be above the liquidation price (%@). Liquidation would come first, so it would never protect you." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El stop loss debe estar por encima del precio de liquidación (%@). La liquidación llegaría antes, así que nunca te protegería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stop loss doit être au-dessus du prix de liquidation (%@). La liquidation interviendrait en premier : il ne vous protégerait donc jamais."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손절 가격은 청산 가격(%@)보다 높아야 합니다. 청산이 먼저 일어나므로 이 손절 주문으로는 절대 보호받을 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "止损必须高于强平价格（%@）。否则会先触发强平，这个止损将永远无法保护你。"
          }
        }
      }
    },
    "Stop-loss must be at least %@ on %@." : {
      "localizations" : {
        "en" : {
