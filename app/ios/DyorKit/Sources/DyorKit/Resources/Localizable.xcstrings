    },
    "That price is above the most a collect can be charged (the gross that completes the reserve). Lower it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese precio supera el máximo que se puede cobrar por una compra (el total bruto que completa la reserva). Bájalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce prix dépasse le maximum qu'un achat peut coûter (le montant brut qui complète la réserve). Baissez-le."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 가격은 수집 1회에 청구할 수 있는 최대 금액(준비금을 채우는 총액)을 초과합니다. 가격을 낮추십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该价格超过了一次收藏可收取的最高金额（即补足储备金所需的总额）。降低价格。"
          }
        }
