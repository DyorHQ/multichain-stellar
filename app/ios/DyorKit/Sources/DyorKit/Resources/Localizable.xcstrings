          }
        }
      }
    },
    "Perpl reported a different order under this close's request number, so its result can't be shown. Check Positions before closing again." : {
      "comment" : "The result of a Perps close the app sent, under 'Result not confirmed yet' in the close sheet and the trade screen's status row: what Perpl reported under the close's request number doesn't match the close sent. Positions is a tab of the Perps screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl informó de otra orden con el número de solicitud de este cierre, así que no se puede mostrar su resultado. Revisa Posiciones antes de volver a cerrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl a signalé un autre ordre sous le numéro de requête de cette clôture : son résultat ne peut donc pas être affiché. Vérifiez Positions avant de clôturer à nouveau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl이 이 종료 주문의 요청 번호로 다른 주문을 보고해 결과를 표시할 수 없습니다. 다시 종료하기 전에 포지션을 확인하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 以此次平仓的请求编号报告了另一个订单，因此无法显示其结果。再次平仓前，先查看“仓位”。"
          }
        }
      }
    },
    "Perpl reported a different order under this order's request number, so its result can't be shown. Check Positions and Orders before placing it again." : {
      "comment" : "The result of a Perps order the app sent, under 'Result not confirmed yet' in the order sheet and the trade screen's status row: what Perpl reported under the order's request number doesn't match the order sent. Positions and Orders are tabs of the Perps screen.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl informó de otra orden con el número de solicitud de esta, así que no se puede mostrar su resultado. Revisa Posiciones y Órdenes antes de volver a colocarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl a signalé un autre ordre sous le numéro de requête de cet ordre : son résultat ne peut donc pas être affiché. Vérifiez Positions et Ordres avant de le placer à nouveau."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl이 이 주문의 요청 번호로 다른 주문을 보고해 결과를 표시할 수 없습니다. 다시 넣기 전에 포지션과 주문을 확인하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl 以此订单的请求编号报告了另一个订单，因此无法显示其结果。再次下单前，先查看“仓位”和“委托”。"
          }
        }
      }
    },
    "Perpl reported a problem." : {
      "comment" : "Shown under 'Waiting for Perpl…' while a Perps order the app sent waits for Perpl's final answer: Perpl reported a problem that a later report may still replace. A reason sentence and 'Waiting for its final answer.' follow.",
      "localizations" : {
