    "It couldn't fill in full, so nothing was filled." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names. 'It' is the order.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo ejecutar por completo, así que no se ejecutó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'a pas pu être exécuté en entier : rien n'a donc été exécuté."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전량 체결될 수 없어 아무것도 체결되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该订单无法全部成交，因此没有任何部分成交。"
          }
        }
      }
    },
    "It expired before it filled, so nothing was opened." : {
      "comment" : "The result of a Perps order the app sent, under 'Order expired' in the order sheet and the trade screen's status row: its time on Perpl ran out before it filled.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiró antes de ejecutarse, así que no se abrió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a expiré avant d'être exécuté : rien n'a donc été ouvert."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체결되기 전에 만료되어 포지션이 열리지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该订单在成交前已过期，因此未开任何仓位。"
          }
        }
      }
    },
    "It expired before it filled. Your position is unchanged." : {
      "comment" : "The result of a Perps order the app sent that reduces the position, under 'Order expired' or 'Not closed': its time on Perpl ran out before it filled.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expiró antes de ejecutarse. Tu posición no cambió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a expiré avant d'être exécuté. Votre position est inchangée."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체결되기 전에 만료되었습니다. 포지션은 그대로입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该订单在成交前已过期。你的仓位没有变化。"
          }
        }
      }
    },
    "It reached Perpl's limit of matches for one order. Try a smaller size." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names. Matches: the resting orders one order can trade against.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcanzó el límite de emparejamientos de Perpl para una sola orden. Prueba con un tamaño menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a atteint la limite d'appariements de Perpl pour un seul ordre. Essayez une taille plus petite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 주문에 대한 Perpl의 매칭 한도에 도달했습니다. 더 작은 수량으로 시도하십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该订单已达到 Perpl 单笔订单的撮合次数上限。尝试更小的数量。"
          }
        }
      }
    },
    "It triggered, but Perpl couldn't execute it." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names. 'It' is a take-profit or stop-loss.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activó, pero Perpl no pudo ejecutarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'est déclenché, mais Perpl n'a pas pu l'exécuter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거되었지만 Perpl이 실행하지 못했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已触发，但 Perpl 无法执行。"
          }
        }
      }
    },
    "It triggered, but expired before it could execute." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names. 'It' is a take-profit or stop-loss.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activó, pero expiró antes de poder ejecutarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'est déclenché, mais a expiré avant de pouvoir s'exécuter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거되었지만 실행되기 전에 만료되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已触发，但在执行前已过期。"
          }
        }
      }
    },
    "It was cancelled before it filled." : {
      "comment" : "The result of a Perps order the app sent, under 'Order cancelled' in the order sheet and the trade screen's status row.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló antes de ejecutarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a été annulé avant d'être exécuté."
