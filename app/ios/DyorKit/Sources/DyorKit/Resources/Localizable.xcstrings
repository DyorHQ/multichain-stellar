    "Closing at this price would leave the position with a negative value, so Perpl refused it." : {
      "comment" : "Why Perpl refused or ended a Perps order or request, as one or two whole sentences. Shown on its own under a result headline ('Not filled', 'Order failed') and as the last placeholder of the take-profit / stop-loss and cancel result lines ('Take-profit not placed: %@'). Perpl and Monad are names.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar a este precio dejaría la posición con un valor negativo, así que Perpl rechazó la orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clôturer à ce prix laisserait la position avec une valeur négative : Perpl a donc refusé l'ordre."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 가격으로 종료하면 포지션 가치가 마이너스가 되므로 Perpl이 주문을 거부했습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按此价格平仓会使仓位价值为负，因此 Perpl 拒绝了该订单。"
          }
        }
      }
    },
