{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Nothing was sent." : {
      "comment" : "The value is a sentence that says why; this one adds that no transaction was sent.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Rien n'a été envoyé."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 아무것도 전송되지 않았습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@未发送任何内容。"
          }
        }
      }
    },
    "%@ did not answer within %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ did not answer within %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no respondió en un plazo de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ n'a pas répondu dans un délai de %2$@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 안에 %1$@의 응답이 없었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 未在 %2$@内响应。"
          }
        }
      }
    },
    "%@ of its margin is in use, and Perpl liquidates at 100%%. Mark %@, liquidation %@. %@" : {
      "comment" : "A margin alert. The values: the margin in use (“85%”), the mark price, the liquidation price, then what to do, a sentence of its own.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of its margin is in use, and Perpl liquidates at 100%%. Mark %2$@, liquidation %3$@. %4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de su margen está en uso, y Perpl liquida al 100%%. Precio de marca %2$@, liquidación %3$@. %4$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ de sa marge est utilisée, et Perpl liquide à 100%%. Prix de marque %2$@, liquidation %3$@. %4$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증거금의 %1$@가 사용 중이며, Perpl은 100%%에서 청산합니다. 마크 가격 %2$@, 청산 가격 %3$@. %4$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该仓位的保证金使用率为 %1$@，Perpl 会在 100%% 时强平。标记价格 %2$@，强平价格 %3$@。%4$@"
          }
        }
      }
    },
    "%@ of its margin is in use. Mark %@, liquidation %@. %@" : {
