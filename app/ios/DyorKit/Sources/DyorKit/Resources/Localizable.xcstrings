        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl에 이미 이 거래 키가 있습니다. 아무것도 변경되지 않았습니다. 다시 연결해 보십시오."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
