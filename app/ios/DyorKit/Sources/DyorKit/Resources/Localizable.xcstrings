          }
        }
      }
    },
    "Perpl rejected this trading key. Remove the API key below and connect again to enroll a fresh one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl rechazó esta clave de trading. Quita la clave API de abajo y vuelve a conectarte para registrar una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl a rejeté cette clé de trading. Supprimez la clé API ci-dessous et reconnectez-vous pour en enregistrer une nouvelle."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perpl이 이 거래 키를 거부했습니다. 아래에서 API 키를 제거한 후 다시 연결하여 새 키를 등록하십시오."
          }
