#!/bin/bash
# dyorhq-leak-guard pre-commit hook (tracked in .githooks/, set up by scripts/dev/install-hooks.sh).
# Blocks a commit that adds a forbidden path (scripts/dev/forbidden-paths.sh with .leakguard: env and key files,
# internal documents, pinned files) or a secret (scripts/dev/secret-scan.sh: .env / Secrets.xcconfig values, key and
# token patterns, seed phrases), plus gitleaks when it is installed. All print locations and names only, never values;
# a missing checker blocks the commit too. Both checkers read the committed .leakguard as well as the staged one, so a
# commit cannot exempt itself. A false positive is fixed in .leakguard (committed on its own), never with --no-verify.
top=$(git rev-parse --show-toplevel) || exit 1
# A traced or BASH_ENV-injected shell could print the values the scanner holds.
run() { env -u BASH_ENV -u SHELLOPTS /bin/bash "$top/scripts/dev/$1" "${@:2}"; }
status=0
run forbidden-paths.sh --staged || status=1
run secret-scan.sh --staged || status=1
# gitleaks (v8.19+), with the committed .gitleaks.toml, when this machine has it; CI always runs it.
if command -v gitleaks >/dev/null 2>&1 && gitleaks version 2>/dev/null | grep -qE '^v?8\.(19|[2-9][0-9])\.'; then
  cfg=$(mktemp "${TMPDIR:-/tmp}/gitleaks.XXXXXX") || exit 1
  args=(); git show HEAD:.gitleaks.toml > "$cfg" 2>/dev/null && args=(--config "$cfg")
  gitleaks git --pre-commit --staged --redact --no-banner "${args[@]}" "$top" || status=1
  rm -f "$cfg"
fi
exit $status
