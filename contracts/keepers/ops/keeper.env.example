# Names of the Fly secrets the keepers Machine reads (build 17 K4). NAMES ONLY: never put a value in this file or in
# any other file in this repository. The secret values live in Fly secrets, loaded through
# ops/make-keeper-secrets.sh (`fly secrets import` on stdin, never a command line), and in the owner's password
# manager. entrypoint.sh copies them into a private tmpfs at boot and drops them from the environment of every keeper
# process. The keepers' public addresses are not secrets: they are pinned in ops/keeper-signers.json.

# Signing keystores, one per unit (cast wallet new): base64 of the keystore file, and base64 of its password.
KEEPER_GRAD_KEYSTORE_B64=
KEEPER_GRAD_PASSWORD_B64=
KEEPER_SWEEPS_KEYSTORE_B64=
KEEPER_SWEEPS_PASSWORD_B64=
KEEPER_BUYBACKS_KEYSTORE_B64=
KEEPER_BUYBACKS_PASSWORD_B64=

# Alerts: the private Discord channel webhook (the keeper posts {content} in 1,900-character chunks).
KEEPER_WEBHOOK_URL=
# Only if the webhook is a Telegram bot instead of Discord.
KEEPER_TELEGRAM_CHAT_ID=

# healthchecks.io ping URLs, one check per unit (the dead-man alarm).
KEEPER_HC_GRAD_URL=
KEEPER_HC_SWEEPS_URL=
KEEPER_HC_BUYBACKS_URL=
KEEPER_HC_GOVERNANCE_URL=

# Send flags, 0 or 1; unset means 0, a dry run. Every unit starts at 0. After the 7-day dry run the owner sets them to
# 1 one at a time (`fly secrets set KEEPER_SEND_GRAD=1`): grad, then buybacks a day later, then sweeps a day later.
# A unit sends only when its keystore derives the address keeper-signers.json pins. Governance never sends.
KEEPER_SEND_GRAD=
KEEPER_SEND_BUYBACKS=
KEEPER_SEND_SWEEPS=

# The one Machine that may send: its id (deploy-fly.sh prints it; not a secret). Set once after the first deploy, and
# again only when the Machine is replaced. Any other Machine (a scale-out or a clone) runs dry runs.
KEEPER_MACHINE_ID=

# Optional: the RPC list, space-separated, in fallback order, instead of rpc3 then rpc4. With a restricted provider key
# it is "<that URL> https://rpc3.monad.xyz https://rpc4.monad.xyz", loaded through make-keeper-secrets.sh (stdin), never
# `fly secrets set`. The keepers read it from their environment, never a command line.
KEEPER_RPC_URLS=
